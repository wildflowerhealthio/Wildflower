{
  "name": "pebble-pkjs",
  "version": "0.0.0",
  "private": true,
  "description": "Build tooling for a Pebble watchapp's PebbleKit JS written in TypeScript: the `vp pack` config that bundles it to one ES5 file for the Pebble SDK, the ES5 lowering and checks that config runs, the PebbleKit JS globals' types (`./pebble-kit-js`), and the waf helpers that bundle it before `pebble build`.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wildflowerhealthio/Wildflower.git",
    "directory": "global/pebble/pebble-pkjs"
  },
  "files": [
    "dist",
    "types",
    "waf"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./pebble-kit-js": {
      "types": "./types/pebble-kit-js.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "dependencies": {
    "acorn": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript-7": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "vite-plus": "catalog:"
  }
}
