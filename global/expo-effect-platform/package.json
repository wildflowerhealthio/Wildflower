{
  "name": "expo-effect-platform",
  "version": "0.1.0",
  "description": "An Effect platform using expo modules",
  "keywords": [
    "ExpoEffectPlatform",
    "expo",
    "expo-effect-platform",
    "react-native"
  ],
  "homepage": "https://github.com/Assessment-is/wildlflower/tree/main/global/expo-effect-platform#readme",
  "bugs": {
    "url": "https://github.com/Assessment-is/wildlflower/issues"
  },
  "license": "MIT",
  "author": "Ruth Marks <ruthmarks151@gmail.com> (https://github.com/ruthmarks151)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Assessment-is/wildlflower.git",
    "directory": "global/expo-effect-platform"
  },
  "files": [
    "android",
    "ios",
    "dist",
    "expo-module.config.json"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./ExpoEffectPlatformModule": {
      "source": "./src/ExpoEffectPlatformModule.ts",
      "default": "./dist/ExpoEffectPlatformModule.js"
    },
    "./package.json": "./package.json",
    "./expo-module.config.json": "./expo-module.config.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "jest": "jest",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@effect/platform": "catalog:",
    "@fast-check/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "babel-preset-expo": "catalog:",
    "effect": "catalog:",
    "expo": "catalog:",
    "expo-module-scripts": "catalog:",
    "fast-check": "catalog:",
    "jest": "catalog:",
    "jest-expo": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform": ">=0.93.0",
    "effect": ">=3.0.0",
    "expo": ">=54.0.0",
    "expo-file-system": ">=19.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.81.0"
  }
}
