{
  "name": "kitchen-sink",
  "version": "0.0.0",
  "description": "Shared schema and type utilities for the Wildflower monorepo.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Assessment-is/wildlflower.git",
    "directory": "global/kitchen-sink"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./bundling": {
      "source": "./src/bundling/index.ts",
      "default": "./dist/bundling.mjs"
    },
    "./crypto-random": {
      "source": "./src/crypto-random/index.ts",
      "default": "./dist/crypto-random.mjs"
    },
    "./polyfills/promise-with-resolvers": {
      "source": "./src/polyfills/promise-with-resolvers.ts",
      "default": "./dist/polyfills/promise-with-resolvers.mjs"
    },
    "./schema": {
      "source": "./src/schema/index.ts",
      "default": "./dist/schema.mjs"
    },
    "./types": {
      "source": "./src/types/index.ts",
      "default": "./dist/types.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp run build",
    "test": "vp test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "bumpp": "^11.0.1",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependenciesMeta": {
    "vite-plus": {
      "optional": true
    }
  }
}
