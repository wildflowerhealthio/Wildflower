{
  "name": "wildflower-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "integration": "vp run -r --concurrency-limit 1 integration",
    "lint:comments": "eslint ./apps ./global ./slices",
    "lint:docs": "markdownlint-cli2 --config .local.markdownlint-cli2.mjs",
    "pack": "vp run --cache -r build",
    "prepare": "vp config",
    "ready": "vp fmt && vp lint && vp run lint:comments && vp run lint:docs && vp run pack && vp run test:all",
    "test:all": "vp test",
    "test:changed": "FC_RISK_MAP=\"$(node scripts/risk-map.ts)\" vp test"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@tanstack/virtual-file-routes": "catalog:",
    "@typescript/native-preview": "catalog:",
    "ajv": "catalog:",
    "effect": "catalog:",
    "eslint": "^10.6.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "fast-check": "catalog:",
    "har-schema": "catalog:",
    "kitchen-sink": "workspace:*",
    "markdownlint": "^0.40.0",
    "markdownlint-cli2": "^0.21.0",
    "markdownlint-cli2-formatter-pretty": "^0.0.9",
    "markdownlint-rule-relative-links": "^5.0.1",
    "typescript-eslint": "^8.57.1",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "why-is-node-running": "catalog:",
    "yaml": "^2.9.0"
  },
  "overrides": {},
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@types/node": "^26",
      "typescript": "5.9.3",
      "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
      "vitest": "4.1.10",
      "react-dom": "19.2.8",
      "@effect/ai": "0.35.0",
      "@effect/cli": "0.75.1",
      "@effect/cluster": "0.58.2",
      "@effect/experimental": "0.60.0",
      "@effect/opentelemetry": "0.63.0",
      "@effect/platform": "0.96.1",
      "@effect/platform-browser": "0.76.0",
      "@effect/platform-bun": "0.89.0",
      "@effect/platform-node": "0.106.0",
      "@effect/printer": "0.49.0",
      "@effect/printer-ansi": "0.49.0",
      "@effect/rpc": "0.75.1",
      "@effect/sql": "0.51.1",
      "@effect/typeclass": "0.40.0",
      "@effect/workflow": "0.16.0",
      "@opentelemetry/api": "1.9.0",
      "@opentelemetry/resources": "2.2.0",
      "@standard-schema/spec": "1.1.0",
      "effect": "3.21.4"
    },
    "patchedDependencies": {
      "effect@3.21.4": "patches/effect@3.21.4.patch"
    }
  }
}
