{
  "name": "wildflower-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "integration": "vp run -r --concurrency-limit 1 integration",
    "lint:comments": "eslint ./apps ./global ./slices",
    "lint:deps": "knip --include unlisted,unresolved --no-progress",
    "lint:docs": "markdownlint-cli2 --config .local.markdownlint-cli2.mjs",
    "pack": "vp run --cache -r build",
    "prepare": "vp config",
    "ready": "vp fmt && vp lint && vp run lint:deps && vp run lint:comments && vp run lint:docs && vp run pack && vp run test:all",
    "test:all": "vp test",
    "test:changed": "FC_RISK_MAP=\"$(node scripts/risk-map.ts)\" vp test"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@tanstack/virtual-file-routes": "catalog:",
    "@wildflowerhealthio/kitchen-sink": "workspace:*",
    "ajv": "catalog:",
    "effect": "catalog:",
    "eslint": "^10.6.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "fast-check": "catalog:",
    "har-schema": "catalog:",
    "knip": "catalog:",
    "markdownlint": "^0.40.0",
    "markdownlint-cli2": "^0.21.0",
    "markdownlint-cli2-formatter-pretty": "^0.0.9",
    "markdownlint-rule-relative-links": "^5.0.1",
    "smol-toml": "catalog:",
    "typescript": "catalog:",
    "typescript-7": "catalog:",
    "typescript-eslint": "^8.57.1",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "why-is-node-running": "catalog:",
    "yaml": "^2.9.0"
  },
  "overrides": {},
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
