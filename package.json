{
  "name": "wildflower-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "domain/*",
      "global/*",
      "packages/*",
      "slices/**",
      "tools/*"
    ]
  },
  "type": "module",
  "scripts": {
    "dev": "vp run website#dev",
    "integration": "vp run -r --concurrency-limit 1 integration",
    "jest": "vp run -r --concurrency-limit 1 jest",
    "lint:comments": "eslint ./apps ./global ./slices",
    "lint:docs": "markdownlint-cli2 --config .local.markdownlint-cli2.mjs",
    "pack": "vp run --cache -r build",
    "prepare": "vp config",
    "ready": "vp fmt && vp lint && vp run lint:comments && vp run lint:docs && vp run test-all && vp run -r build",
    "test-all": "vp test && vp run jest"
  },
  "devDependencies": {
    "@typescript/native-preview": "catalog:",
    "eslint": "^9.39.4",
    "eslint-plugin-expo": "^1.0.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "markdownlint": "^0.40.0",
    "markdownlint-cli2": "^0.21.0",
    "markdownlint-cli2-formatter-pretty": "^0.0.9",
    "markdownlint-rule-relative-links": "^5.0.1",
    "typescript-eslint": "^8.57.1",
    "vite-plus": "^0.1.20",
    "why-is-node-running": "catalog:"
  },
  "overrides": {},
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@types/node": "^24",
      "@opentelemetry/api": "1.9.0",
      "typescript": "5.9.3"
    }
  }
}
