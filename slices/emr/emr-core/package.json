{
  "name": "store-core",
  "version": "0.0.0",
  "description": "FHIR R4 data types, schemas, queries, and resources backed by LiveStore.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Assessment-is/wildflower.git",
    "directory": "slices/store/store-core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./contexts": {
      "source": "./src/contexts/index.ts",
      "default": "./dist/contexts/index.js"
    },
    "./livestore": {
      "source": "./src/livestore/index.ts",
      "default": "./dist/livestore/index.js"
    },
    "./schemas": {
      "source": "./src/schemas/index.ts",
      "default": "./dist/schemas/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp run build",
    "test": "vp test"
  },
  "devDependencies": {
    "@effect/platform": "catalog:",
    "@livestore/adapter-node": "catalog:",
    "@livestore/common": "catalog:",
    "@livestore/livestore": "catalog:",
    "@livestore/peer-deps": "catalog:",
    "@livestore/utils": "catalog:",
    "@types/fhir": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "bumpp": "^11.0.1",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "kitchen-sink": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform": "catalog:",
    "@livestore/common": "catalog:",
    "@livestore/livestore": "catalog:",
    "@livestore/peer-deps": "catalog:",
    "@livestore/utils": "catalog:",
    "effect": "catalog:",
    "kitchen-sink": "workspace:*"
  }
}
