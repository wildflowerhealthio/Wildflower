{
  "name": "fhir-r4",
  "version": "0.0.1",
  "description": "FHIR R4 wire schemas, HttpApi description, and HTTP client",
  "license": "UNLICENSED",
  "author": "Ruth Marks",
  "type": "module",
  "exports": {
    "./clients": {
      "source": "./src/clients/index.ts",
      "default": "./dist/clients/index.js"
    },
    "./data-types": {
      "source": "./src/data-types/index.ts",
      "default": "./dist/data-types/index.js"
    },
    "./http-api-definition": {
      "source": "./src/http-api-definition/index.ts",
      "default": "./dist/http-api-definition/index.js"
    },
    "./resources": {
      "source": "./src/resources/index.ts",
      "default": "./dist/resources/index.js"
    },
    "./telemetry": {
      "source": "./src/telemetry/index.ts",
      "default": "./dist/telemetry/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp run build",
    "test": "vp test"
  },
  "devDependencies": {
    "@effect/platform": "catalog:",
    "@types/fhir": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "bumpp": "^12.0.0",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "kitchen-sink": "workspace:*",
    "navigation-core": "workspace:*",
    "shared-structures-core": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform": "catalog:",
    "effect": "catalog:",
    "kitchen-sink": "workspace:*",
    "navigation-core": "workspace:*",
    "shared-structures-core": "workspace:*"
  }
}
