# Generated for TypeScript consumers (tests, the package's own
# `tauriSnifferBootstrapScript` export). Regenerated on every
# `pnpm install` by the package's `prepare` script. Mirrors the
# precedent set by browser-sniffer-injected's sniffer-script.generated.ts.
#
# The matching raw IIFE at `embedded/tauri-bootstrap.js` is intentionally
# NOT ignored — it is committed so the Rust CI workflow (which does not
# run pnpm) can `include_str!` it at compile time.
src/tauri-bootstrap.generated.ts
