# Generated by the package's `prepare` script (which runs on every
# `pnpm install`) — both the TS consumer-facing string export and the
# raw IIFE that the Rust crate `browser-sniffer-tauri-rust` embeds via
# `include_str!`. CI's tauri lint/test job runs `pnpm install` before
# `cargo build` so the regenerated bytes are picked up.
src/tauri-bootstrap.generated.ts
# The native-popup bootstrap (iOS/Android), generated by
# `scripts/build-native-bootstrap.mts`. Same lifecycle as the Tauri one above.
src/native-bootstrap.generated.ts
# `dist/tauri-bootstrap.js` is covered by the workspace root .gitignore's
# `**/dist/**` rule — kept centralized there for consistency with the
# other slices' build outputs.
