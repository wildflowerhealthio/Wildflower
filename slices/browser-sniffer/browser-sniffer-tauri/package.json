{
  "name": "browser-sniffer-tauri",
  "version": "0.0.0",
  "private": true,
  "description": "Tauri bootstrap for the browser-sniffer: a tiny shim that re-exports the RN-WebView postMessage contract over Tauri's event bus, plus the unmodified installSniffer() call. The bundled IIFE is consumed by browser-sniffer-tauri-rust via include_str!.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Assessment-is/wildflower.git",
    "directory": "slices/browser-sniffer/browser-sniffer-tauri"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build-tauri-bootstrap.mts && vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "generate-tauri-bootstrap": "node scripts/build-tauri-bootstrap.mts",
    "prepare": "node scripts/build-tauri-bootstrap.mts",
    "test": "node scripts/build-tauri-bootstrap.mts && vp test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "browser-sniffer-core": "workspace:*",
    "browser-sniffer-injected": "workspace:*",
    "effect": "catalog:",
    "effect-messaging-core": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "browser-sniffer-injected": "workspace:*"
  }
}
