{
  "name": "browser-sniffer-core",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-process contract (Schema-typed bridge + message schemas) for the injected browser sniffer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Assessment-is/wildflower.git",
    "directory": "slices/browser-sniffer/browser-sniffer-core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./bridge": {
      "source": "./src/bridge.ts",
      "default": "./dist/bridge.js"
    },
