      "source": "./src/telemetry/index.ts",
      "default": "./dist/telemetry/index.js"
    },
    "./web-view-source": {
      "source": "./src/web-view-source.ts",
      "default": "./dist/web-view-source.js"
    },
    "./http-api-definition": {
      "source": "./src/http-api-definition/index.ts",
      "default": "./dist/http-api-definition/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@effect/platform": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "effect": "catalog:",
    "effect-messaging-core": "workspace:*",
    "fast-check": "catalog:",
    "kitchen-sink": "workspace:*",
    "shared-structures-core": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
