{
  "name": "browser-sniffer-expo",
  "version": "0.0.0",
  "private": true,
  "description": "Expo wrapper around react-native-webview that injects the browser-sniffer and dispatches its messages via BrowserSnifferBridge.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Assessment-is/wildflower.git",
    "directory": "slices/browser-sniffer/browser-sniffer-expo"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@typescript/native-preview": "catalog:",
    "browser-sniffer-core": "workspace:*",
    "browser-sniffer-injected": "workspace:*",
    "effect": "catalog:",
    "effect-messaging-core": "workspace:*",
    "expo": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-webview": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "browser-sniffer-core": "workspace:*",
    "browser-sniffer-injected": "workspace:*",
    "effect": "catalog:",
    "effect-messaging-core": "workspace:*",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-webview": ">=13.0.0"
  }
}
