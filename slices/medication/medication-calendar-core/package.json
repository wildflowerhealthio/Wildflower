{
  "name": "@wildflowerhealthio/medication-calendar-core",
  "version": "0.0.0",
  "private": true,
  "description": "Pure calendar layer for a patient's medication list: supply-duration parsing, next-fill / exhaustion date math, calendar event derivation, and month-grid math. No DOM, no FHIR, no platform imports.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@wildflowerhealthio/fhir-utility": "workspace:*",
    "@wildflowerhealthio/kitchen-sink": "workspace:*",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "typescript-7": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@wildflowerhealthio/fhir-utility": "workspace:*",
    "effect": "catalog:"
  }
}
