{
  "name": "medication-sponsorship-core",
  "version": "0.0.0",
  "private": true,
  "description": "Pure logic for the sponsored-drug programs (innoviCares / RxHelp): raw-list decoders, province coverage, brand+generic matching of medications (scored by medication-core), and grouping. No DOM, no FHIR, no platform imports.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "kitchen-sink": "workspace:*",
    "medication-core": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:",
    "kitchen-sink": "workspace:*",
    "medication-core": "workspace:*"
  }
}
