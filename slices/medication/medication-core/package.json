{
  "name": "medication-core",
  "version": "0.0.0",
  "private": true,
  "description": "Fuzzy medication-name matching shared by the medication slices: the minimal `Medication` value type, name normalization / tokenization, and the exact / strong / partial containment scoring — plus, behind the `medication-core/fhir` subpath, the FHIR R4 `MedicationRequest` adapters that build those values. No DOM, no platform imports.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./fhir": {
      "source": "./src/fhir/index.ts",
      "default": "./dist/fhir/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "fhir-r4": "workspace:*",
    "kitchen-sink": "workspace:*",
    "medication-calendar-core": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:",
    "fhir-r4": "workspace:*",
    "kitchen-sink": "workspace:*",
    "medication-calendar-core": "workspace:*"
  }
}
