{
  "name": "branding-react",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Wildflower chrome for every web surface: the full site header and footer (marketing site), a slim brand bar (SMART apps and Tauri), the app icon, and layout tokens.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "source": "./src/styles.css",
      "default": "./dist/style.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "branding-core": "workspace:*",
    "fast-check": "catalog:",
    "jsdom": "catalog:",
    "kitchen-sink": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-tundraish": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "branding-core": "workspace:*",
    "react": "catalog:",
    "react-tundraish": "workspace:*"
  }
}
