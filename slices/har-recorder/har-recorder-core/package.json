{
  "name": "har-recorder-core",
  "version": "0.0.0",
  "private": true,
  "description": "The HAR Recorder's pure core: `Recording` accumulates the browser-sniffer's response events into an `HttpArchive.Log`, `isOmittedFromRecording` decides what a recording keeps, `recordingFileName` names the file, `toHar` emits the archive through `http-archive`, and `HarRecorderBridge` carries the finished text to the host that writes it. No DOM, no fs, no React.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Assessment-is/wildflower.git",
    "directory": "slices/har-recorder/har-recorder-core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "browser-sniffer-core": "workspace:*",
    "effect": "catalog:",
    "effect-messaging-core": "workspace:*",
    "fast-check": "catalog:",
    "http-archive": "workspace:*",
    "kitchen-sink": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "web-trace-core": "workspace:*"
  },
  "peerDependencies": {
    "browser-sniffer-core": "workspace:*",
    "effect": "catalog:",
    "effect-messaging-core": "workspace:*",
    "http-archive": "workspace:*",
    "web-trace-core": "workspace:*"
  }
}
