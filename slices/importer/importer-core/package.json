{
  "name": "importer-core",
  "version": "0.0.0",
  "private": true,
  "description": "The pure core of the importer slice: the closed format registry (every registered FileImporterDescriptor, typed per format) and the batch machinery the shell drives — group a pick by format, read it into review units, re-decode one format's units under new settings, and plan a unit's write from its reviewed selection. No DOM, no fs, no React.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Assessment-is/wildflower.git",
    "directory": "slices/importer/importer-core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@effect/platform": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "dicom": "workspace:*",
    "dicom-importer-core": "workspace:*",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "fhir-r4": "workspace:*",
    "har-importer-core": "workspace:*",
    "importer-fundamentals": "workspace:*",
    "kitchen-sink": "workspace:*",
    "lifelabs-pdf-importer-core": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "dicom-importer-core": "workspace:*",
    "effect": "catalog:",
    "fhir-r4": "workspace:*",
    "har-importer-core": "workspace:*",
    "importer-fundamentals": "workspace:*",
    "lifelabs-pdf-importer-core": "workspace:*"
  }
}
