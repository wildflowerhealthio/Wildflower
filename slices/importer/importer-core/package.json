{
  "name": "@wildflowerhealthio/importer-core",
  "version": "0.0.0",
  "private": true,
  "description": "The pure core of the importer slice: the closed format registry (every registered FileImporter, typed per format) and the batch machinery the shell drives — group a pick by format, read it into one result per format, re-decode one format under new settings, and plan a format's write from its reviewed selection. No DOM, no fs, no React.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wildflowerhealthio/Wildflower.git",
    "directory": "slices/importer/importer-core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@effect/platform": "catalog:",
    "@types/node": "catalog:",
    "@wildflowerhealthio/dicom": "workspace:*",
    "@wildflowerhealthio/dicom-importer-core": "workspace:*",
    "@wildflowerhealthio/fhir-r4": "workspace:*",
    "@wildflowerhealthio/har-importer-core": "workspace:*",
    "@wildflowerhealthio/importer-fundamentals": "workspace:*",
    "@wildflowerhealthio/kitchen-sink": "workspace:*",
    "@wildflowerhealthio/lifelabs-pdf-importer": "workspace:*",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "typescript-7": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@wildflowerhealthio/dicom-importer-core": "workspace:*",
    "@wildflowerhealthio/fhir-r4": "workspace:*",
    "@wildflowerhealthio/har-importer-core": "workspace:*",
    "@wildflowerhealthio/importer-fundamentals": "workspace:*",
    "@wildflowerhealthio/lifelabs-pdf-importer": "workspace:*",
    "effect": "catalog:"
  }
}
