{
  "name": "@wildflowerhealthio/dicom-importer-core",
  "version": "0.0.0",
  "private": true,
  "description": "The DICOM binding of the importer slice (core layer): byte-level .dcm detection, the source-file coding that stores a DICOM file as a FHIR DocumentReference filed under the patient its header names, header tag parsing, and the FHIR R4 synthesis behind the format's FileImporter. No DOM, no fs, no React.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wildflowerhealthio/Wildflower.git",
    "directory": "slices/importer/dicom-importer-core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./source-file": {
      "source": "./src/source-file.ts",
      "default": "./dist/source-file.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@wildflowerhealthio/dicom": "workspace:*",
    "@wildflowerhealthio/fhir-r4": "workspace:*",
    "@wildflowerhealthio/importer-fundamentals": "workspace:*",
    "@wildflowerhealthio/kitchen-sink": "workspace:*",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "typescript-7": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@wildflowerhealthio/dicom": "workspace:*",
    "@wildflowerhealthio/fhir-r4": "workspace:*",
    "@wildflowerhealthio/importer-fundamentals": "workspace:*",
    "@wildflowerhealthio/kitchen-sink": "workspace:*",
    "effect": "catalog:"
  }
}
