{
  "name": "lifelabs-pdf-importer-core",
  "version": "0.0.0",
  "private": true,
  "description": "The LifeLabs PDF binding of the importer slice: the concrete FileImporterDescriptor for format 'lifelabs-pdf' — the positioned-text dialect that reads a LifeLabs patient report's pages into lab reports, the FHIR R4 synthesis (Patient, Practitioner, DiagnosticReport, Observation), the one response kind an import is recognized through, the time-zone setting, and the FHIR persist sink. No DOM, no fs, no React.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Assessment-is/wildflower.git",
    "directory": "slices/importer/lifelabs-pdf-importer-core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./test-helpers": {
      "source": "./src/test-helpers.ts",
      "default": "./dist/test-helpers.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "fhir-r4": "workspace:*",
    "http-extraction-fundamentals": "workspace:*",
    "importer-fundamentals": "workspace:*",
    "kitchen-sink": "workspace:*",
    "pdf-anonymizer-core": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "web-trace-core": "workspace:*"
  },
  "peerDependencies": {
    "effect": "catalog:",
    "fhir-r4": "workspace:*",
    "http-extraction-fundamentals": "workspace:*",
    "importer-fundamentals": "workspace:*",
    "kitchen-sink": "workspace:*",
    "pdf-anonymizer-core": "workspace:*",
    "web-trace-core": "workspace:*"
  }
}
