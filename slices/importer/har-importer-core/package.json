{
  "name": "har-importer-core",
  "version": "0.0.0",
  "private": true,
  "description": "The HAR binding of the importer slice: the concrete FileImporter for format 'har' — decoding through the `http-archive` package's HttpArchive projection, the HAR source-file DocumentReference coding the importer mints from, the FHIR R4 response-kind pool, and HAR settings. The HAR format itself lives in `http-archive` (slices/file-formats); the shape-preserving anonymizer in har-anonymizer-core (slices/anonymizer). No DOM, no fs, no React.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Assessment-is/wildflower.git",
    "directory": "slices/importer/har-importer-core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./source-file": {
      "source": "./src/source-file/index.ts",
      "default": "./dist/source-file/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@effect/platform": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "effect": "catalog:",
