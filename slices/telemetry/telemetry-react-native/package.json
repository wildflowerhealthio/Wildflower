{
  "name": "telemetry-react-native",
  "version": "0.0.0",
  "description": "React Native Effect OpenTelemetry layer wiring Sentry and OTLP exporters for the Wildflower client.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Assessment-is/wildflower.git",
    "directory": "slices/telemetry/telemetry-react-native"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "jest": "jest",
    "prepublishOnly": "vp run build",
    "test": "vp test --passWithNoTests"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/runtime": "catalog:",
    "@effect/opentelemetry": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@sentry/opentelemetry": "catalog:",
    "@sentry/react-native": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@typescript/native-preview": "catalog:",
    "babel-preset-expo": "catalog:",
    "bumpp": "^11.0.1",
    "effect": "catalog:",
    "expo": "catalog:",
    "jest": "catalog:",
    "jest-expo": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "telemetry-core": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@effect/opentelemetry": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@sentry/opentelemetry": "catalog:",
    "@sentry/react-native": "catalog:",
    "effect": "catalog:",
    "telemetry-core": "workspace:*"
  }
}
