{
  "name": "@wildflowerhealthio/telemetry-react",
  "version": "0.0.0",
  "private": true,
  "description": "The browser side of Wildflower telemetry in React: the telemetry consent gate every web app starts behind (the non-dismissable consent dialog, the hook that keeps the answer in localStorage, and the status control that reopens it), and what an app root does with the answer (`useConsentedTelemetryStart`, which starts telemetry with the app's own DSN and tags, and `CrashReportingBoundary`, which reports render crashes).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wildflowerhealthio/Wildflower.git",
    "directory": "slices/telemetry/telemetry-react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp run build",
    "test": "vp test"
  },
  "devDependencies": {
