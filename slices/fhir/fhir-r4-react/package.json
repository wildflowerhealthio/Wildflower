{
  "name": "@wildflowerhealthio/fhir-r4-react",
  "version": "0.0.0",
  "private": true,
  "description": "React surface for the FHIR R4 slice — a tokenless `buildFhirR4ResourcesClientLayer()` (the host's `HttpClient` carries the credential) + structural router-context (`sliceRuntimeLayer`, `useFhirR4ResourcesRuntimeLayer`) the host app merges into its composed `runtimeLayer`, plus the `Patient` TanStack-Query read. Cross-slice consumers: `gatekeeper-react`'s patient picker (`usePatientsQuery`) and `collector-react`'s `useSyncRunner` (imperative per-resource PUT via the runtime layer). Mirrors gatekeeper-react's migrated pattern; names are FhirR4-specific so future FHIR-version slices can coexist.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./smart": {
      "source": "./src/smart/index.ts",
      "default": "./dist/smart/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "dependencies": {
    "fhirclient": "^2.5.4"
  },
  "devDependencies": {
    "@effect/platform": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@wildflowerhealthio/fhir-r4": "workspace:*",
    "@wildflowerhealthio/gatekeeper-core": "workspace:*",
    "@wildflowerhealthio/kitchen-sink": "workspace:*",
    "@wildflowerhealthio/shared-structures-react": "workspace:*",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@wildflowerhealthio/fhir-r4": "workspace:*",
    "@wildflowerhealthio/gatekeeper-core": "workspace:*",
    "@wildflowerhealthio/kitchen-sink": "workspace:*",
    "@wildflowerhealthio/shared-structures-react": "workspace:*",
    "effect": "catalog:",
    "react": "catalog:"
  }
}
