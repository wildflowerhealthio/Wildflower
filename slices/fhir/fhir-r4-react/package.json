{
  "name": "@wildflowerhealthio/fhir-r4-react",
  "version": "0.0.0",
  "private": true,
  "description": "React surface for the FHIR R4 slice — a tokenless `buildFhirR4ResourcesClientLayer()` (the host's `HttpClient` carries the credential) + structural router-context (`sliceRuntimeLayer`, `useFhirR4ResourcesRuntimeLayer`) the host app merges into its composed `runtimeLayer`, and the `useRunAuthed` hook a consumer's queries read it through. Mirrors authorization-react's migrated pattern; names are FhirR4-specific so future FHIR-version slices can coexist.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./smart": {
      "source": "./src/smart/index.ts",
      "default": "./dist/smart/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@effect/platform": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@wildflowerhealthio/authorization-core": "workspace:*",
    "@wildflowerhealthio/fhir-r4": "workspace:*",
    "@wildflowerhealthio/kitchen-sink": "workspace:*",
    "@wildflowerhealthio/shared-structures-react": "workspace:*",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@wildflowerhealthio/authorization-core": "workspace:*",
    "@wildflowerhealthio/fhir-r4": "workspace:*",
    "@wildflowerhealthio/kitchen-sink": "workspace:*",
    "@wildflowerhealthio/shared-structures-react": "workspace:*",
    "effect": "catalog:",
    "react": "catalog:"
  }
}
