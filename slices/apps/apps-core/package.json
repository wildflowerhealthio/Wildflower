{
  "name": "apps-core",
  "version": "0.0.0",
  "private": true,
  "description": "App registry, hosting-tier escalation protocol, and HTTP API for launching FHIR apps.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Assessment-is/wildflower.git",
    "directory": "slices/apps/apps-core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
