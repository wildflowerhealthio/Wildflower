{
  "name": "vendor-apps",
  "version": "0.0.0",
  "private": true,
  "description": "Vendored third-party FHIR apps inlined as static assets and served via HttpApi (e.g. patient-browser).",
  "type": "module",
  "exports": {
    "./patient-browser": {
      "source": "./src/patient-browser.ts",
      "default": "./dist/patient-browser.js"
    },
    "./http-api-definition": {
      "source": "./src/http-api-definition/index.ts",
      "default": "./dist/http-api-definition/index.js"
    },
    "./http-api-implementation": {
      "source": "./src/http-api-implementation/index.ts",
      "default": "./dist/http-api-implementation/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "build:assets": "node scripts/generate-patient-browser.mjs",
    "check": "vp check",
    "dev": "vp pack --watch"
  },
  "devDependencies": {
    "@effect/platform": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform": "catalog:",
    "effect": "catalog:"
  }
}
