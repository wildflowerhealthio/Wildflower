{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["es2024", "dom"],
    "jsx": "react-jsx",
    "moduleDetection": "force",
    "module": "esnext",
    "moduleResolution": "bundler",
    "customConditions": ["source"],
    "resolveJsonModule": true,
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "declaration": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src", "tests"]
}
