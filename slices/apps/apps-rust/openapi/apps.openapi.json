{
  "openapi": "3.1.0",
  "info": {
    "title": "Apps Catalogue API",
    "version": "0.0.0"
  },
  "paths": {
    "/apps": {
      "get": {
        "tags": [
          "Catalogue"
        ],
        "summary": "`GET /apps` — the full registry in display order. Owner-gated by the host.",
        "operationId": "handle_list_apps",
        "responses": {
          "200": {
            "description": "Every app in the registry, ordered by position",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AppRegistration"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/apps/{id}": {
      "get": {
        "tags": [
          "Launch"
        ],
        "summary": "`GET /apps/{id}` — the web launch arm. A home-screen tile is a real\n`<a href=\"/apps/{id}\" rel=\"nofollow noreferrer\">`, so a plain click navigates\nthe current tab and a cmd/ctrl-click opens a new one — native affordances a\nform-`POST` or `fetch` can't preserve. The auth cookie rides the anchor\nnavigation (even the initial document request, before any JS), so a forwarded\n`GET` authenticates and the server `302`s to the resolved target. Shares\n[`launch`] with the `POST` arm — identical resolve-then-dispatch and auth\nposture.",
        "operationId": "handle_launch_app_get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "App id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Host sink opened the launch URL for a loopback caller (no redirect)"
          },
          "302": {
            "description": "Redirect (Location header) to the resolved launch URL"
          },
          "401": {
            "description": "A loopback launch whose caller is not the device owner"
          },
          "404": {
            "description": "No app has this id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppNotFoundBody"
                }
              }
            }
          },
          "503": {
            "description": "No reachable launch target (forwarded launch with no public host, or a requires_tunnel app while the tunnel is down)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LaunchUnavailableBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Launch"
        ],
        "summary": "`POST /apps/{id}` — launch an app (`404` if no app has this id). The loopback\n(Tauri) arm drives this through the typed client so the owner bearer rides\nalong. See the module docs for the resolve-then-dispatch flow and the auth\nposture; the body is shared with [`handle_launch_app_get`] via [`launch`].",
        "operationId": "handle_launch_app",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "App id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Host sink opened the launch URL for a loopback caller (no redirect)"
          },
          "302": {
            "description": "Redirect (Location header) to the resolved launch URL"
          },
          "401": {
            "description": "A loopback launch whose caller is not the device owner"
          },
          "404": {
            "description": "No app has this id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppNotFoundBody"
                }
              }
            }
          },
          "503": {
            "description": "No reachable launch target (forwarded launch with no public host, or a requires_tunnel app while the tunnel is down)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LaunchUnavailableBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Catalogue"
        ],
        "summary": "`DELETE /apps/{id}` — remove a cloud app or an uploaded self-hosted app.\nOwner-gated by the host.",
        "operationId": "handle_delete_app",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "App id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The app was removed"
          },
          "404": {
            "description": "No app has this id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppNotFoundBody"
                }
              }
            }
          },
          "409": {
            "description": "The app exists but is not removable (system / seeded self-hosted apps)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppNotEditableBody"
                }
              }
            }
          }
        }
      }
    },
    "/cloud-apps": {
      "post": {
        "tags": [
          "Cloud apps"
        ],
        "summary": "`POST /cloud-apps` — create a cloud app. Owner-gated by the host.",
        "operationId": "handle_create_cloud_app",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CloudAppBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The created cloud app detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CloudAppDetail"
                }
              }
            }
          },
          "400": {
            "description": "Empty name (`InvalidName`) or bad url (`InvalidUrl`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidFieldBody"
                }
              }
            }
          }
        }
      }
    },
    "/cloud-apps/{id}": {
      "get": {
        "tags": [
          "Cloud apps"
        ],
        "summary": "`GET /cloud-apps/{id}` — the cloud editor detail. Owner-gated by the host.",
        "operationId": "handle_get_cloud_app",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "App id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The cloud app detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CloudAppDetail"
                }
              }
            }
          },
          "404": {
            "description": "No cloud app has this id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppNotFoundBody"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Cloud apps"
        ],
        "summary": "`PUT /cloud-apps/{id}` — replace a cloud app's content. Owner-gated by the host.",
        "operationId": "handle_replace_cloud_app",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "App id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CloudAppBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The updated cloud app detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CloudAppDetail"
                }
              }
            }
          },
          "400": {
            "description": "Empty name (`InvalidName`) or bad url (`InvalidUrl`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidFieldBody"
                }
              }
            }
          },
          "404": {
            "description": "No cloud app has this id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppNotFoundBody"
                }
              }
            }
          }
        }
      }
    },
    "/home-screen": {
      "put": {
        "tags": [
          "Home screen"
        ],
        "summary": "`PUT /home-screen` — atomically reorder + enable/disable every app. Owner-gated\nby the host. The body must list **every** registry app exactly once (its order\nis the new display order); a missing / duplicated / unknown id is\n`400 InvalidHomeScreen`. Returns the resulting catalogue in its new order.",
        "operationId": "handle_replace_home_screen",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/HomeScreenEntry"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The whole registry in its new order",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AppRegistration"
                  }
                }
              }
            }
          },
          "400": {
            "description": "The body wasn't an exact permutation of the registry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidHomeScreenBody"
                }
              }
            }
          }
        }
      }
    },
    "/self-hosted-apps": {
      "post": {
        "tags": [
          "Self-hosted apps"
        ],
        "summary": "`POST /self-hosted-apps` — install a self-hosted app from the uploaded `bundle`.\nOwner-gated by the host; the body limit is raised for this route (see the\nrouter wiring).",
        "operationId": "handle_create_self_hosted_app",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/CreateSelfHostedAppMultipart"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The installed self-hosted app detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelfHostedAppDetail"
                }
              }
            }
          },
          "400": {
            "description": "Empty/unusable or already-taken name (`InvalidName`) or a bad bundle (`InvalidZip`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidFieldBody"
                }
              }
            }
          }
        }
      }
    },
    "/self-hosted-apps/{id}": {
      "get": {
        "tags": [
          "Self-hosted apps"
        ],
        "summary": "`GET /self-hosted-apps/{id}` — the self-hosted editor detail. Owner-gated by\nthe host.",
        "operationId": "handle_get_self_hosted_app",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "App id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The self-hosted app detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelfHostedAppDetail"
                }
              }
            }
          },
          "404": {
            "description": "No self-hosted app has this id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppNotFoundBody"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Self-hosted apps"
        ],
        "summary": "`PUT /self-hosted-apps/{id}` — replace a self-hosted app's launch path.\nOwner-gated by the host.",
        "operationId": "handle_replace_self_hosted_app",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "App id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelfHostedAppBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The updated self-hosted app detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelfHostedAppDetail"
                }
              }
            }
          },
          "400": {
            "description": "The launch path isn't origin-relative (`InvalidUrl`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidFieldBody"
                }
              }
            }
          },
          "404": {
            "description": "No self-hosted app has this id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppNotFoundBody"
                }
              }
            }
          },
          "409": {
            "description": "A seeded self-hosted app is edit-protected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppNotEditableBody"
                }
              }
            }
          }
        }
      }
    },
    "/system-apps/{id}": {
      "get": {
        "tags": [
          "System apps"
        ],
        "summary": "`GET /system-apps/{id}` — the system read-only detail. Owner-gated by the host.",
        "operationId": "handle_get_system_app",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "App id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The system app detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemAppDetail"
                }
              }
            }
          },
          "404": {
            "description": "No system app has this id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppNotFoundBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppKind": {
        "type": "string",
        "description": "Which kind an app is — the discriminator. Serialized as its kebab string\n(`\"system\"` / `\"self-hosted\"` / `\"cloud\"`), the same value stored in the\n`CHECK`-constrained `app_registrations.kind` column and sent on the wire.",
        "enum": [
          "system",
          "self-hosted",
          "cloud"
        ]
      },
      "AppNotEditableBody": {
        "type": "object",
        "description": "Wire shape for `AppNotEditable` (409) — the app exists but isn't editable /\nremovable: a system app, or a seeded self-hosted app. (A per-kind path given an\nid of another kind is a `404`, not a `409` — the mismatch can't be expressed.)",
        "required": [
          "error",
          "id"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        }
      },
      "AppNotFoundBody": {
        "type": "object",
        "description": "Wire shape for `AppNotFound`. Matches the TS `AppNotFoundSchema`.",
        "required": [
          "error",
          "id"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        }
      },
      "AppRegistration": {
        "type": "object",
        "description": "A registration row — the shared half of one app's record. Diesel maps it\nto/from `app_registrations` (the [`AppKindColumn`] mapping on `kind`); serde\nprojects it onto the `GET /apps` wire item (`position` omitted, `client_id` →\n`isSmart`).",
        "required": [
          "id",
          "kind",
          "onHomescreen",
          "name",
          "localOnly",
          "isSmart",
          "requiresTunnel"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable id, globally unique across all kinds (the registration PK)."
          },
          "kind": {
            "$ref": "#/components/schemas/AppKind",
            "description": "The discriminator — which configuration table holds this id's payload."
          },
          "onHomescreen": {
            "type": "boolean",
            "description": "Whether the app's tile shows on the home screen. Curated atomically by\n`PUT /home-screen` (see [`replace_placements`](super::AppsStore::replace_placements))."
          },
          "name": {
            "type": "string"
          },
          "subtitle": {
            "type": [
              "string",
              "null"
            ],
            "description": "`None` means \"no subtitle\"; the wire omits an absent one."
          },
          "localOnly": {
            "type": "boolean",
            "description": "The declared no-egress flag (a UI badge this pass)."
          },
          "isSmart": {
            "type": "boolean",
            "description": "Soft reference to a gatekeeper `clients.client_id`; `None` for non-SMART\napps. Never leaves the host: the wire carries the derived `isSmart` boolean."
          },
          "requiresTunnel": {
            "type": "boolean",
            "description": "Whether a launch must bring the tunnel up first (a launch-readiness pill).\n`false` for system / self-hosted; meaningful only for cloud apps."
          }
        }
      },
      "CloudAppBody": {
        "type": "object",
        "description": "The JSON body shared by `POST /cloud-apps` (create) and `PUT /cloud-apps/{id}`\n(content replace): a cloud app's editable content. `url` is read as a raw string\nso a bad value yields the structured `400 InvalidUrl` rather than a generic\ndeserialize error. Matches the TS `CloudAppBodySchema`.",
        "required": [
          "name",
          "url",
          "requiresTunnel"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "subtitle": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string",
            "description": "The launch URL template (`{origin}` / `{launch}` tokens), validated to\n`400 InvalidUrl` through the write-side [`AppUrl`](crate::domain::AppUrl)\nfilter."
          },
          "requiresTunnel": {
            "type": "boolean"
          }
        }
      },
      "CloudAppDetail": {
        "type": "object",
        "description": "The `GET`/`POST`/`PUT /cloud-apps…` wire shape — the registration fields plus\nthe stored `url` template and `isRemovable`. Built from the cloud\n`(registration, configuration)` pair.",
        "required": [
          "id",
          "kind",
          "onHomescreen",
          "name",
          "localOnly",
          "isSmart",
          "requiresTunnel",
          "url",
          "isRemovable"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/AppKind"
          },
          "onHomescreen": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "subtitle": {
            "type": [
              "string",
              "null"
            ]
          },
          "localOnly": {
            "type": "boolean"
          },
          "isSmart": {
            "type": "boolean"
          },
          "requiresTunnel": {
            "type": "boolean"
          },
          "url": {
            "type": "string",
            "description": "The stored launch URL template (`{origin}` / `{launch}` tokens), serialized\nas its canonical string."
          },
          "isRemovable": {
            "type": "boolean",
            "description": "Always `true` for a cloud app; carried for a uniform editor contract."
          }
        }
      },
      "CreateSelfHostedAppMultipart": {
        "type": "object",
        "description": "Documents the `multipart/form-data` body for OpenAPI. The handler reads the\nparts manually via [`Multipart`], so this is never deserialized directly (the\n`Deserialize` derive only carries the `serde` rename to the generated schema).\n`name` is always present; `subtitle` is optional; `bundle` is the uploaded zip.\nMatches the TS `CreateSelfHostedAppBodySchema`.",
        "required": [
          "name",
          "bundle"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "subtitle": {
            "type": [
              "string",
              "null"
            ]
          },
          "bundle": {
            "type": "string",
            "format": "binary",
            "description": "The app's static files as a zip."
          }
        }
      },
      "HomeScreenEntry": {
        "type": "object",
        "description": "One entry in the `PUT /home-screen` body: an app id and its desired\n`onHomescreen` flag. The entry's index in the array is its new display\n`position`. Matches the TS `HomeScreenEntrySchema`.",
        "required": [
          "id",
          "onHomescreen"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "onHomescreen": {
            "type": "boolean"
          }
        }
      },
      "InvalidFieldBody": {
        "type": "object",
        "description": "Wire shape for a 400 carrying a discriminant + human-readable reason. Reused\nfor `InvalidUrl` (a bad app URL / launch path), `InvalidName` (an empty name),\nand `InvalidZip` (an unusable uploaded bundle) — all write-side field\nvalidations the client renders inline. The `error` discriminant lets a client\ntell them apart.",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "InvalidHomeScreenBody": {
        "type": "object",
        "description": "Wire shape for a 400 `InvalidHomeScreen` — the `PUT /home-screen` body wasn't\nan exact permutation of the registry. Matches the TS `InvalidHomeScreenSchema`.",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "LaunchUnavailableBody": {
        "type": "object",
        "description": "Wire shape for a 503 `LaunchUnavailable` — a launch with no *reachable*\ntarget. The SPA surfaces the failure rather than following a dead redirect.",
        "required": [
          "error",
          "reason"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "SelfHostedAppBody": {
        "type": "object",
        "description": "The `PUT /self-hosted-apps/{id}` body — the editable launch path. Absent or\nempty clears it back to root-serving. Matches the TS\n`SelfHostedAppBodySchema`.",
        "properties": {
          "launchPath": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "SelfHostedAppDetail": {
        "type": "object",
        "description": "The `GET`/`POST`/`PUT /self-hosted-apps…` wire shape — the registration fields\nplus `launchPath` (absent for a root-served bundle), `seeded`, and\n`isRemovable`. The public `subdomain` / loopback `port` / on-disk\n`content_folder` are host-internal and stay off the wire.",
        "required": [
          "id",
          "kind",
          "onHomescreen",
          "name",
          "localOnly",
          "isSmart",
          "requiresTunnel",
          "seeded",
          "isRemovable"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/AppKind"
          },
          "onHomescreen": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "subtitle": {
            "type": [
              "string",
              "null"
            ]
          },
          "localOnly": {
            "type": "boolean"
          },
          "isSmart": {
            "type": "boolean"
          },
          "requiresTunnel": {
            "type": "boolean"
          },
          "launchPath": {
            "type": [
              "string",
              "null"
            ],
            "description": "The stored SMART launch path (origin-relative, with `{origin}` / `{launch}`\ntokens), or absent for a root-served (`index.html`) app."
          },
          "seeded": {
            "type": "boolean",
            "description": "`true` for a migration-seeded app (edit/delete-protected)."
          },
          "isRemovable": {
            "type": "boolean",
            "description": "Whether the owner can remove this app (`!seeded`)."
          }
        }
      },
      "SystemAppDetail": {
        "type": "object",
        "description": "The read-only `GET /system-apps/{id}` wire shape — the registration fields plus\nthe display-only `url` template. A system app is never editable, so it carries\nno `isRemovable`.",
        "required": [
          "id",
          "kind",
          "onHomescreen",
          "name",
          "localOnly",
          "isSmart",
          "requiresTunnel",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/AppKind"
          },
          "onHomescreen": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "subtitle": {
            "type": [
              "string",
              "null"
            ]
          },
          "localOnly": {
            "type": "boolean"
          },
          "isSmart": {
            "type": "boolean"
          },
          "requiresTunnel": {
            "type": "boolean"
          },
          "url": {
            "type": "string",
            "description": "The stored launch URL template (`{origin}` token), serialized as its\ncanonical string. Display-only — a system app is never editable."
          }
        }
      }
    }
  }
