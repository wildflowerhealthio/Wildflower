{
  "openapi": "3.1.0",
  "info": {
    "title": "Apps Catalogue API",
    "version": "0.0.0"
  },
  "paths": {
    "/apps": {
      "get": {
        "tags": [
          "Catalogue"
        ],
        "summary": "`GET /apps` — the full catalogue in display order. Gating is applied by the\nhost (the slice exposes one router; there is no longer an ungated public\nsurface here).",
        "operationId": "handle_list_apps",
        "responses": {
          "200": {
            "description": "Every app in the registry, ordered by position",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AppListEntry"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Catalogue"
        ],
        "summary": "`POST /apps` — create a cloud or self-hosted app. Owner-gated by the host; the\nbody limit is raised for the upload arm (see the router wiring).",
        "operationId": "handle_create_app",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/CreateAppMultipart"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The created app (the provenance-tagged catalogue entry)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppListEntry"
                }
              }
            }
          },
          "400": {
            "description": "Empty/unusable name (`InvalidName`), bad url (`InvalidUrl`), or a bad bundle (`InvalidZip`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidFieldBody"
                }
              }
            }
          }
        }
      }
    },
    "/apps/{id}": {
      "get": {
        "tags": [
          "Launch"
        ],
        "summary": "`GET /apps/{id}` — the web launch arm. A home-screen tile is a real\n`<a href=\"/apps/{id}\" rel=\"nofollow noreferrer\">`, so a plain click navigates\nthe current tab and a cmd/ctrl-click opens a new one — native affordances a\nform-`POST` or `fetch` can't preserve. The auth cookie rides the anchor\nnavigation (even the initial document request, before any JS), so a forwarded\n`GET` authenticates and the server `302`s to the resolved target. Shares\n[`launch`] with the `POST` arm — identical resolve-then-dispatch and auth\nposture.",
        "operationId": "handle_launch_app_get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "App id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Host sink opened the launch URL for a loopback caller (no redirect)"
          },
          "302": {
            "description": "Redirect (Location header) to the resolved launch URL"
          },
          "401": {
            "description": "A loopback launch whose caller is not the device owner"
          },
          "404": {
            "description": "No app has this id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppNotFoundBody"
                }
              }
            }
          },
          "503": {
            "description": "No reachable launch target (forwarded launch with no public host, or a requires_tunnel app while the tunnel is down)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LaunchUnavailableBody"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Catalogue"
        ],
        "summary": "`PUT /apps/{id}` — replace an editable app's content. Owner-gated by the host.",
        "operationId": "handle_replace_app",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "App id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppContentBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The updated app (the provenance-tagged catalogue entry)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppListEntry"
                }
              }
            }
          },
          "400": {
            "description": "Empty name (`InvalidName`) or bad url/launch path (`InvalidUrl`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidFieldBody"
                }
              }
            }
          },
          "404": {
            "description": "No app has this id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppNotFoundBody"
                }
              }
            }
          },
          "409": {
            "description": "Not editable: a system app, a seeded self-hosted app, or a body whose provenance doesn't match the stored app",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppNotEditableBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Launch"
        ],
        "summary": "`POST /apps/{id}` — launch an app (`404` if no app has this id). The loopback\n(Tauri) arm drives this through the typed client so the owner bearer rides\nalong. See the module docs for the resolve-then-dispatch flow and the auth\nposture; the body is shared with [`handle_launch_app_get`] via [`launch`].",
        "operationId": "handle_launch_app",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "App id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Host sink opened the launch URL for a loopback caller (no redirect)"
          },
          "302": {
            "description": "Redirect (Location header) to the resolved launch URL"
          },
          "401": {
            "description": "A loopback launch whose caller is not the device owner"
          },
          "404": {
            "description": "No app has this id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppNotFoundBody"
                }
              }
            }
          },
          "503": {
            "description": "No reachable launch target (forwarded launch with no public host, or a requires_tunnel app while the tunnel is down)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LaunchUnavailableBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Catalogue"
        ],
        "summary": "`DELETE /apps/{id}` — remove a cloud app or an uploaded self-hosted app.\nOwner-gated by the host.",
        "operationId": "handle_delete_app",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "App id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The row was removed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeletedBody"
                }
              }
            }
          },
          "404": {
            "description": "No app has this id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppNotFoundBody"
                }
              }
            }
          },
          "409": {
            "description": "The app exists but is not removable (system / seeded self-hosted apps)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppNotEditableBody"
                }
              }
            }
          }
        }
      }
    },
    "/home-screen": {
      "put": {
        "tags": [
          "Home screen"
        ],
        "summary": "`PUT /home-screen` — atomically reorder + enable/disable every app. Owner-gated\nby the host. The body must list **every** registry app exactly once (its order\nis the new display order); a missing / duplicated / unknown id is\n`400 InvalidHomeScreen`. Returns the resulting catalogue in its new order.",
        "operationId": "handle_replace_home_screen",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/HomeScreenEntry"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The whole catalogue in its new order",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AppListEntry"
                  }
                }
              }
            }
          },
          "400": {
            "description": "The body wasn't an exact permutation of the registry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidHomeScreenBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppContentBody": {
        "oneOf": [
          {
            "type": "object",
            "description": "Full replace of a cloud app's content.",
            "required": [
              "name",
              "url",
              "requiresTunnel",
              "provenance"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "subtitle": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "url": {
                "type": "string"
              },
              "requiresTunnel": {
                "type": "boolean"
              },
              "provenance": {
                "type": "string",
                "enum": [
                  "cloud"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "Replace a self-hosted app's launch path (absent / empty → root-served).",
            "required": [
              "provenance"
            ],
            "properties": {
              "launchPath": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "provenance": {
                "type": "string",
                "enum": [
                  "self-hosted"
                ]
              }
            }
          }
        ],
        "description": "`PUT /apps/{id}` body — a `provenance`-discriminated union matching the TS\n`AppContentBodySchema`. Only the editable kinds have an arm (system apps are\nnever editable). `url` is read as a raw string so a bad value yields the\nstructured `400 InvalidUrl` rather than a generic deserialize error."
      },
      "AppListEntry": {
        "oneOf": [
          {
            "type": "object",
            "description": "A system app — a compiled-in shell route. No record table, no extra fields.",
            "required": [
              "id",
              "enabled",
              "name",
              "localOnly",
              "smart",
              "removable",
              "provenance"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "name": {
                "type": "string"
              },
              "subtitle": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "localOnly": {
                "type": "boolean"
              },
              "smart": {
                "type": "boolean"
              },
              "removable": {
                "type": "boolean"
              },
              "provenance": {
                "type": "string",
                "enum": [
                  "system"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "A cloud app — carries its stored launch `url` template and the\ntunnel-requirement flag from the `cloud_apps` record.",
            "required": [
              "id",
              "enabled",
              "name",
              "localOnly",
              "smart",
              "removable",
              "url",
              "requiresTunnel",
              "provenance"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "name": {
                "type": "string"
              },
              "subtitle": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "localOnly": {
                "type": "boolean"
              },
              "smart": {
                "type": "boolean"
              },
              "removable": {
                "type": "boolean"
              },
              "url": {
                "type": "string",
                "description": "The stored launch URL template (`{origin}` / `{launch}` tokens),\nserialized as its canonical string. See [`AppUrl`]."
              },
              "requiresTunnel": {
                "type": "boolean"
              },
              "provenance": {
                "type": "string",
                "enum": [
                  "cloud"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "A self-hosted app — carries its stored `launch_path` (absent for a\nroot-served bundle) from the `self_hosted_apps` record.",
            "required": [
              "id",
              "enabled",
              "name",
              "localOnly",
              "smart",
              "removable",
              "provenance"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "name": {
                "type": "string"
              },
              "subtitle": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "localOnly": {
                "type": "boolean"
              },
              "smart": {
                "type": "boolean"
              },
              "removable": {
                "type": "boolean"
              },
              "launchPath": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The stored SMART launch path (origin-relative, with `{origin}` /\n`{launch}` tokens), or absent for a root-served (`index.html`) app."
              },
              "provenance": {
                "type": "string",
                "enum": [
                  "self-hosted"
                ]
              }
            }
          }
        ],
        "description": "One app-catalogue entry on the wire, discriminated on `provenance`. Serialized\ninternally-tagged: every variant carries a `\"provenance\"` field (`\"system\"` /\n`\"cloud\"` / `\"self-hosted\"`) alongside its fields, so utoipa renders it as a\n`oneOf` and the TS client decodes it as a discriminated union."
      },
      "AppNotEditableBody": {
        "type": "object",
        "description": "Wire shape for `AppNotEditable` (409) — the app exists but isn't editable\nthrough the surface a mutation used (a system app, a seeded self-hosted app,\nor a body whose provenance doesn't match the stored app).",
        "required": [
          "error",
          "id"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        }
      },
      "AppNotFoundBody": {
        "type": "object",
        "description": "Wire shape for `AppNotFound`. Matches the TS `AppNotFoundSchema`.",
        "required": [
          "error",
          "id"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        }
      },
      "CreateAppMultipart": {
        "type": "object",
        "description": "Documents the `multipart/form-data` body for OpenAPI. The handler reads the\nparts manually via [`Multipart`], so this is never deserialized directly (the\n`Deserialize` derive only carries the `serde` rename to the generated schema).\nFields cross the wire as text — `requiresTunnel` is `\"true\"` / `\"false\"` — and\n`bundle` is the uploaded file. `provenance` and `name` are always present; the\nrest are kind-specific, so they're optional here and the handler requires the\nright ones per `provenance`. Mirrors the TS `CreateAppBodySchema`.",
        "required": [
          "provenance",
          "name"
        ],
        "properties": {
          "provenance": {
            "type": "string",
            "description": "`\"cloud\"` or `\"self-hosted\"`."
          },
          "name": {
            "type": "string"
          },
          "subtitle": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Cloud only: the launch URL template."
          },
          "requiresTunnel": {
            "type": [
              "string",
              "null"
            ],
            "description": "Cloud only: `\"true\"` / `\"false\"`."
          },
          "bundle": {
            "type": [
              "string",
              "null"
            ],
            "format": "binary",
            "description": "Self-hosted only: the app's static files as a zip."
          }
        }
      },
      "DeletedBody": {
        "type": "object",
        "required": [
          "deleted"
        ],
        "properties": {
          "deleted": {
            "type": "boolean"
          }
        }
      },
      "HomeScreenEntry": {
        "type": "object",
        "description": "One entry in the `PUT /home-screen` body: an app id and its desired `enabled`\nflag. The entry's index in the array is its new display `position`. Matches\nthe TS `HomeScreenEntrySchema`.",
        "required": [
          "id",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "InvalidFieldBody": {
        "type": "object",
        "description": "Wire shape for a 400 carrying a discriminant + human-readable reason. Reused\nfor `InvalidUrl` (a bad app URL / launch path), `InvalidName` (an empty name),\nand `InvalidZip` (an unusable uploaded bundle) — all write-side field\nvalidations the client renders inline. The `error` discriminant lets a client\ntell them apart.",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "InvalidHomeScreenBody": {
        "type": "object",
        "description": "Wire shape for a 400 `InvalidHomeScreen` — the `PUT /home-screen` body wasn't\nan exact permutation of the registry. Matches the TS `InvalidHomeScreenSchema`.",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "LaunchUnavailableBody": {
        "type": "object",
        "description": "Wire shape for a 503 `LaunchUnavailable` — a launch with no *reachable*\ntarget. The SPA surfaces the failure rather than following a dead redirect.",
        "required": [
          "error",
          "reason"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
