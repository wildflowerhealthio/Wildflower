{
  "name": "har-anonymizer-core",
  "version": "0.0.0",
  "private": true,
  "description": "The HAR engine of the anonymizer slice: the shape-preserving pseudonymizer that redacts a captured session at the export boundary — the redaction policy (enum carve-out, namespace URIs, per-path overrides), the HMAC-keyed value→pseudonym table, the shape detectors and fake generators, and the leaf walkers over both TraceExchange and HttpArchive entries. No DOM, no fs, no React.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Assessment-is/wildflower.git",
    "directory": "slices/anonymizer/har-anonymizer-core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "ajv": "catalog:",
    "anonymizer-fundamentals": "workspace:*",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "har-schema": "catalog:",
    "http-archive": "workspace:*",
    "kitchen-sink": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "web-trace-core": "workspace:*"
  },
  "peerDependencies": {
    "anonymizer-fundamentals": "workspace:*",
    "effect": "catalog:",
    "http-archive": "workspace:*",
    "kitchen-sink": "workspace:*",
    "web-trace-core": "workspace:*"
  }
}
