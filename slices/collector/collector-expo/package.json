{
  "name": "collector-expo",
  "version": "0.0.0",
  "private": true,
  "description": "Expo wrapper for the collector slice — CollectorWebView (embeds wildflower-react with NavigationBridge + CollectorBridge) and RunSyncModalScreen (mounts BrowserSnifferWebView and forwards sniffer events back through CollectorBridge).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Assessment-is/wildflower.git",
    "directory": "slices/collector/collector-expo"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@typescript/native-preview": "catalog:",
    "browser-sniffer-core": "workspace:*",
    "browser-sniffer-expo": "workspace:*",
    "collector-fundamentals": "workspace:*",
    "effect": "catalog:",
    "effect-messaging-core": "workspace:*",
    "effect-messaging-expo": "workspace:*",
    "expo": "catalog:",
    "expo-router": "catalog:",
    "expo-tundraish": "workspace:*",
    "gatekeeper-core": "workspace:*",
    "navigation-core": "workspace:*",
    "react": "catalog:",
    "react-native": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wildflower-react": "workspace:*"
  },
  "peerDependencies": {
    "browser-sniffer-core": "workspace:*",
    "browser-sniffer-expo": "workspace:*",
    "collector-fundamentals": "workspace:*",
    "effect": "catalog:",
    "effect-messaging-core": "workspace:*",
    "effect-messaging-expo": "workspace:*",
    "expo-router": "*",
    "expo-tundraish": "workspace:*",
    "gatekeeper-core": "workspace:*",
    "navigation-core": "workspace:*",
    "react": "catalog:",
    "react-native": "catalog:",
    "wildflower-react": "workspace:*"
  }
}
