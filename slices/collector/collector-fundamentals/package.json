{
  "name": "collector-fundamentals",
  "version": "0.0.0",
  "private": true,
  "description": "Pure-logic representations every collector implementation depends on: Remote / EntityDefinition / RemoteResponse / Link / WebViewSource. No bridge, no livestore, no HTTP. Concrete client packages (e.g. fhir-r4-client-collector) MUST depend only on this package; collector-core sits on top and registers them.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Assessment-is/wildflower.git",
    "directory": "slices/collector/collector-fundamentals"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./model": {
      "source": "./src/model/index.ts",
      "default": "./dist/model/index.js"
    },
    "./test-helpers": {
      "source": "./src/test-helpers.ts",
      "default": "./dist/test-helpers.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@fast-check/vitest": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "kitchen-sink": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:",
    "kitchen-sink": "workspace:*"
  }
}
