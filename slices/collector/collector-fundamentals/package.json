{
  "name": "collector-fundamentals",
  "version": "0.0.0",
  "private": true,
  "description": "The shared representations every collector implementation depends on: CollectorDescriptor / CollectorEntityDefinition / RemoteResponse / ScrapingPlan / Step / WebViewSource, plus the `./config-form` view contract (ConfigFormProps) a collector's account form is written against. Builds on importer-fundamentals' vocabulary (EntityDefinition / ImportableResponse / UrlMatch). No store, no HTTP runtime. Concrete client packages (e.g. fhir-r4-client-collector) depend on this package (and may build their config-form UI on the ./config-form contract); collector-registry sits on top and registers them.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Assessment-is/wildflower.git",
    "directory": "slices/collector/collector-fundamentals"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./bridge": {
      "source": "./src/bridge.ts",
      "default": "./dist/bridge.js"
    },
    "./config-form": {
      "source": "./src/config-form.ts",
      "default": "./dist/config-form.js"
    },
    "./handler": {
      "source": "./src/handler/index.ts",
      "default": "./dist/handler/index.js"
    },
    "./model": {
      "source": "./src/model/index.ts",
      "default": "./dist/model/index.js"
    },
    "./telemetry": {
      "source": "./src/telemetry/index.ts",
      "default": "./dist/telemetry/index.js"
    },
    "./test-helpers": {
      "source": "./src/test-helpers.ts",
      "default": "./dist/test-helpers.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@typescript/native-preview": "catalog:",
    "browser-sniffer-core": "workspace:*",
    "effect": "catalog:",
    "effect-messaging-core": "workspace:*",
    "fast-check": "catalog:",
    "importer-fundamentals": "workspace:*",
    "kitchen-sink": "workspace:*",
    "react": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "browser-sniffer-core": "workspace:*",
    "effect": "catalog:",
    "effect-messaging-core": "workspace:*",
    "importer-fundamentals": "workspace:*",
    "kitchen-sink": "workspace:*",
    "react": "catalog:"
  }
}
