{
  "name": "web-trace-collector",
  "version": "0.0.0",
  "private": true,
  "description": "Development-purposes collector that records a hand-driven browsing session: point it at a URL, browse the portal by hand, close the window, and every XHR/fetch the pages fired is on device as a FHIR DocumentReference via web-trace-core's codec. Captures everything and filters nothing — the content-type allowlist governs bodies, never whether an exchange is recorded.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Assessment-is/wildflower.git",
    "directory": "slices/collector/web-trace-collector"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native-preview": "catalog:",
    "browser-sniffer-core": "workspace:*",
    "collector-fundamentals": "workspace:*",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "fhir-r4": "workspace:*",
    "http-extraction-fundamentals": "workspace:*",
    "jsdom": "catalog:",
    "kitchen-sink": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-kitchen-sink": "workspace:*",
    "react-tundraish": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "web-trace-core": "workspace:*",
    "web-trace-source": "workspace:*"
  },
  "peerDependencies": {
    "browser-sniffer-core": "workspace:*",
