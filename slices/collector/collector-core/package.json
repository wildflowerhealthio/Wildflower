{
  "name": "collector-core",
  "version": "0.0.0",
  "private": true,
  "description": "Pure logic for the collector slice: remote/entity/link/web-view-source abstractions, livestore bindings for the remotes table, HTTP API definition + handlers, and the cross-process CollectorBridge.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Assessment-is/wildflower.git",
    "directory": "slices/collector/collector-core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./bridge": {
      "source": "./src/bridge.ts",
      "default": "./dist/bridge.js"
    },
    "./model": {
      "source": "./src/model/index.ts",
      "default": "./dist/model/index.js"
    },
    "./clients": {
      "source": "./src/clients/index.ts",
      "default": "./dist/clients/index.js"
    },
    "./contexts": {
      "source": "./src/contexts/index.ts",
      "default": "./dist/contexts/index.js"
    },
    "./http-api-definition": {
      "source": "./src/http-api-definition/index.ts",
      "default": "./dist/http-api-definition/index.js"
    },
    "./http-api-implementation": {
      "source": "./src/http-api-implementation/index.ts",
      "default": "./dist/http-api-implementation/index.js"
    },
    "./livestore": {
      "source": "./src/livestore/index.ts",
      "default": "./dist/livestore/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@effect/platform": "catalog:",
    "@effect/vitest": "catalog:",
    "@fast-check/vitest": "catalog:",
    "@livestore/common": "catalog:",
    "@livestore/livestore": "catalog:",
