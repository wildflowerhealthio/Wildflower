{
  "name": "gatekeeper-core",
  "version": "0.0.0",
  "description": "OAuth domain package: HTTP API definitions, generated clients, bridge contract, and page paths for the gatekeeper slice (served by gatekeeper-rust).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Assessment-is/wildflower.git",
    "directory": "slices/gatekeeper/gatekeeper-core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./clients": {
      "source": "./src/clients/index.ts",
      "default": "./dist/clients/index.js"
    },
    "./contexts": {
      "source": "./src/contexts/index.ts",
      "default": "./dist/contexts/index.js"
    },
    "./http-api-definition": {
      "source": "./src/http-api-definition/index.ts",
      "default": "./dist/http-api-definition/index.js"
    },
    "./bridge": {
      "source": "./src/bridge.ts",
      "default": "./dist/bridge.js"
    },
    "./page-paths": {
      "source": "./src/page-paths.ts",
      "default": "./dist/page-paths.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "generate:openapi-schemas": "mkdir -p src/http-api-definition/generated && openapi-to-effect gen ../gatekeeper-rust/openapi/gatekeeper-oauth.openapi.json src/http-api-definition/generated",
    "prepublishOnly": "vp run build",
    "test": "vp test"
  },
  "devDependencies": {
    "@effect/platform": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "bumpp": "^12.1.0",
    "effect": "catalog:",
    "effect-messaging-core": "workspace:*",
    "fast-check": "catalog:",
    "jose": "catalog:",
    "kitchen-sink": "workspace:*",
    "navigation-core": "workspace:*",
    "openapi-to-effect": "^0.9.3",
    "prettier": "^3.9.6",
    "prettier-plugin-jsdoc": "^1.3.0",
    "shared-structures-core": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "why-is-node-running": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform": "catalog:",
    "effect": "catalog:",
    "effect-messaging-core": "workspace:*",
    "jose": "catalog:",
    "kitchen-sink": "workspace:*",
    "navigation-core": "workspace:*",
    "shared-structures-core": "workspace:*"
  }
}
