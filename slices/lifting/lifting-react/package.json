{
  "name": "lifting-react",
  "version": "0.0.0",
  "private": true,
  "description": "Browser UI for the lifting slice: the today screen that logs a session set by set, the progression review, the plan editor (with a StrongLifts 5x5 seed) and the session history. Plain props and callbacks; every decision comes from lifting-core, and nothing here fetches or knows FHIR.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "jsdom": "catalog:",
    "kitchen-sink": "workspace:*",
    "lifting-core": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-kitchen-sink": "workspace:*",
    "react-tundraish": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:",
    "lifting-core": "workspace:*",
    "react": "catalog:",
    "react-kitchen-sink": "workspace:*",
    "react-tundraish": "workspace:*"
  }
}
