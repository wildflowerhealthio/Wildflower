{
  "openapi": "3.1.0",
  "info": {
    "title": "Request Log API",
    "version": "0.0.0"
  },
  "paths": {
    "/requests": {
      "get": {
        "tags": [
          "Request log"
        ],
        "summary": "`GET /requests` — one page of the request log, newest first, with the\ncursor for the next. Gated by [`Scoped<LiveRequestLogReader>`]\n(`wildflower/RequestLog.r`).",
        "operationId": "handle_list_requests",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "description": "The previous page's `nextCursor`: only requests older than it.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "client",
            "in": "query",
            "description": "Only requests whose verified caller is this OAuth client.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "address",
            "in": "query",
            "description": "Only requests from this client address.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "auth",
            "in": "query",
            "description": "Only requests in this auth case: `authorized` (a verified caller, not\nrefused), `public` (no verified caller, not refused) or `refused` (a\nbearer gate's `401` or a scope `403`).",
            "required": false,
            "schema": {
              "type": "string",
              "description": "The `auth` filter `GET /requests` accepts: how a logged request fared\nagainst auth. Mirrors [`RequestAuth`].",
              "enum": [
                "authorized",
                "public",
                "refused"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of the request log, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestLogPageBody"
                }
              }
            }
          },
          "403": {
            "description": "The caller's token doesn't cover `wildflower/RequestLog.r`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InsufficientScopeBody"
                }
              }
            }
          }
        }
      }
    },
    "/requests/callers": {
      "get": {
        "tags": [
          "Request log"
        ],
        "summary": "`GET /requests/callers` — who reached the server: one row per (caller, client\naddress), the group with the newest request first. Gated by [`Scoped<LiveRequestLogReader>`] (`wildflower/RequestLog.r`).",
        "operationId": "handle_list_callers",
        "responses": {
          "200": {
            "description": "The request log grouped by caller and client address, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CallerSummaryBody"
                  }
                }
              }
            }
          },
          "403": {
            "description": "The caller's token doesn't cover `wildflower/RequestLog.r`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InsufficientScopeBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CallerSummaryBody": {
        "type": "object",
        "description": "What the request log holds for one (caller, client address) pair — a row of\n`GET /requests/callers`. The client's display name is not included; resolve\n`clientId` through gatekeeper's client list.",
        "required": [
          "clientId",
          "address",
          "firstSeen",
          "lastSeen",
          "requestCount",
          "refusedCount",
          "lastStatus",
          "lastRefusal"
        ],
        "properties": {
          "clientId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The verified caller's OAuth client, or `null` for the requests no\nbearer gate verified."
          },
          "address": {
            "type": [
              "string",
              "null"
            ],
            "description": "The visitor's address the request's `Forwarded` header named, or `null`\nwhen it named none."
          },
          "firstSeen": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeen": {
            "type": "string",
            "format": "date-time"
          },
          "requestCount": {
            "type": "integer",
            "format": "int64"
          },
          "refusedCount": {
            "type": "integer",
            "format": "int64",
            "description": "How many were refused: a bearer gate's `401` or a scope `403`."
          },
          "lastStatus": {
            "type": "integer",
            "format": "int32",
            "description": "The newest request's response status.",
            "minimum": 0
          },
          "lastRefusal": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RequestRefusalBody",
                "description": "The newest request's refusal, or `null` when no bearer gate refused it."
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "InsufficientScopeBody": {
        "type": "object",
        "description": "Wire shape for a 403 — the caller authenticated, but their token doesn't cover\nthe scope(s) an operation requires. `missingScopes` names the scopes the\ncaller must additionally hold.",
        "required": [
          "error",
          "missingScopes"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Always `\"InsufficientScope\"` — the discriminant a client switches on."
          },
          "missingScopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The rendered scopes the caller lacks."
          }
        }
      },
      "LoggedRequestBody": {
        "type": "object",
        "description": "One request in the log — an element of `GET /requests`. `path` is\nthe route the request was reduced to: no ids and no query string.",
        "required": [
          "id",
          "receivedAt",
          "clientId",
          "address",
          "servedHost",
          "method",
          "path",
          "status",
          "responseBytes",
          "durationMs",
          "refusal"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "The request's place in the log; a higher id is newer."
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "clientId": {
            "type": [
              "string",
              "null"
            ]
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "servedHost": {
            "type": [
              "string",
              "null"
            ],
            "description": "The public `host[:port]` the visitor addressed."
          },
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "responseBytes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "The response body's length, or `null` when it wasn't known up front.",
            "minimum": 0
          },
          "durationMs": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "refusal": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RequestRefusalBody"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "RequestLogPageBody": {
        "type": "object",
        "description": "One page of `GET /requests`, newest first.",
        "required": [
          "requests",
          "nextCursor"
        ],
        "properties": {
          "requests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LoggedRequestBody"
            }
          },
          "nextCursor": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "The `cursor` that reads the next page, or `null` on the last one."
          }
        }
      },
      "RequestRefusalBody": {
        "type": "string",
        "description": "Why a bearer gate refused a logged request with a `401`. Mirrors\n[`RequestRefusal`].",
        "enum": [
          "missingToken",
          "tokenRejected",
          "revoked"
        ]
      }
    }
  }
}
