{
  "name": "synthetic-data-core",
  "version": "0.0.0",
  "private": true,
  "description": "The synthetic data set assembler and reader: importer output as a published data set's files — fhir/<ResourceType>/<id>.json per resource, each source file an importer read under har/ or dicom/ and linked from its DocumentReference, and an index.json manifest of each person's files — the reading half that fetches a file back into the resource the import wrote, and the reference order a reader writes the resources to a FHIR server in. Pure — no DOM, no fs, no React.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Assessment-is/wildflower.git",
    "directory": "slices/synthetic-data/synthetic-data-core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./test-helpers": {
      "source": "./src/test-helpers.ts",
      "default": "./dist/test-helpers.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "dicom-importer-core": "workspace:*",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "fhir-r4": "workspace:*",
    "har-importer-core": "workspace:*",
    "importer-fundamentals": "workspace:*",
    "kitchen-sink": "workspace:*",
    "synthetic-data-dicom": "workspace:*",
    "synthetic-data-fundamentals": "workspace:*",
    "synthetic-data-rexall-be-well": "workspace:*",
    "synthetic-data-shoppers-drugmart": "workspace:*",
    "typescript": "catalog:",
    "typescript-7": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "dicom-importer-core": "workspace:*",
    "effect": "catalog:",
    "fhir-r4": "workspace:*",
    "har-importer-core": "workspace:*",
    "importer-fundamentals": "workspace:*"
  }
}
