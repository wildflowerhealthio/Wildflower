{
  "name": "synthetic-data-core",
  "version": "0.0.0",
  "private": true,
  "description": "The synthetic data snapshot assembler: importer output as a Snapshot of a FHIR store — a header (index.json: as-of, generator, members, totals) and entries, one per resource (fhir/<ResourceType>/<id>.json) and one per source file an importer read (har/ or dicom/, linked from its DocumentReference), each with a Schema codec to the file a static host serves it as — and the reader that fetches them back, checked, into the resources the import wrote. Pure — no DOM, no fs, no React.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Assessment-is/wildflower.git",
    "directory": "slices/synthetic-data/synthetic-data-core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./test-helpers": {
      "source": "./src/test-helpers.ts",
      "default": "./dist/test-helpers.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "dicom-importer-core": "workspace:*",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "fhir-r4": "workspace:*",
    "har-importer-core": "workspace:*",
    "importer-fundamentals": "workspace:*",
    "kitchen-sink": "workspace:*",
    "synthetic-data-dicom": "workspace:*",
    "synthetic-data-fundamentals": "workspace:*",
    "synthetic-data-rexall-be-well": "workspace:*",
    "synthetic-data-shoppers-drugmart": "workspace:*",
    "typescript": "catalog:",
    "typescript-7": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "dicom-importer-core": "workspace:*",
    "effect": "catalog:",
    "fhir-r4": "workspace:*",
    "har-importer-core": "workspace:*",
    "importer-fundamentals": "workspace:*"
  }
}
