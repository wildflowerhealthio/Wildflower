{
  "name": "shared-structures-tauri",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Tauri webview bootstrap: the in-page browser top bar (Back / Reload / URL chrome) injected into webviews that load arbitrary pages, plus the sandboxed-webview bootstrap IIFE that wires it to the Tauri event bus. The bar is shared with browser-sniffer-tauri; the bundled IIFE is consumed by shared-structures-tauri-rust via include_str!.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Assessment-is/wildflower.git",
    "directory": "slices/shared-structures/shared-structures-tauri"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./top-bar": {
      "source": "./src/inject-browser-top-bar.ts",
      "default": "./dist/inject-browser-top-bar.js"
    },
    "./bridge": {
      "source": "./src/bridge-tags.ts",
      "default": "./dist/bridge-tags.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack && node scripts/build-tauri-bootstrap.mts",
    "check": "vp check",
    "dev": "vp pack --watch",
    "generate-tauri-bootstrap": "node scripts/build-tauri-bootstrap.mts",
    "prepare": "node scripts/build-tauri-bootstrap.mts",
    "test": "node scripts/build-tauri-bootstrap.mts && vp test"
  },
  "devDependencies": {
    "@tauri-apps/api": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "effect-messaging-tauri": "workspace:*",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
