{
  "image": "mcr.microsoft.com/devcontainers/typescript-node:bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "Anthropic.claude-code",
        "streetsidesoftware.code-spell-checker",
        "oxc.oxc-vscode",
        "vitest.explorer",
        "YoavBls.pretty-ts-errors",
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml"
      ]
    }
  },
  "features": {
    // No version-pinned `typescript-node:26` image exists yet (MCR's newest is
    // node 24), so the base uses the unversioned `bookworm` tag and this feature
    // pins Node 26 to satisfy engines >=26.0.0. Switch to a `26-bookworm` image
    // tag and drop this feature once one ships.
    "ghcr.io/devcontainers/features/node:1": {
      "version": "26"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "1.95.0",
      "profile": "default"
    }
  },
  "mounts": [
    "source=claude-config,target=/node/.claude,type=volume",
    "source=node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=wf-data,target=/data,type=volume"
  ],
  "runArgs": ["--env-file", ".devcontainer/devcontainer.env"],
  "forwardPorts": [5173],

  "postCreateCommand": "bash -i .devcontainer/postCreateCommand.sh"
}
