<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- tauri-plugin-background-service's manifest asks for what its calling,
         ringing, other foreground-service types and boot recovery need. The
         Wildflower server runs as a shortService foreground service, which
         needs no type permission and can't start at boot, so the merge drops
         each one. What the server does need comes from the plugin and stays:
         FOREGROUND_SERVICE, POST_NOTIFICATIONS, ACCESS_NETWORK_STATE. -->
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.host_app"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- singleTop, not singleTask: tauri-plugin-native-page-browser's
             Custom Tab runs in this activity's task, and a singleTask root
             would finish it whenever the launcher icon is tapped mid-sign-in.
             The app has no deep links that need a single task. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTop"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>

        <!-- The plugin's foreground service, narrowed to the one type the
             server starts as (background_service_foreground_type in
             tauri-shared-config.json). A shortService takes no subtype, so the
             plugin's specialUse one goes. -->
        <service
            android:name="app.tauri.backgroundservice.LifecycleService"
            android:foregroundServiceType="shortService"
            tools:replace="android:foregroundServiceType">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                tools:node="remove" />
        </service>

        <!-- The plugin's boot receiver restarts its service after a reboot. A
             shortService can't start from the background, and the server runs
             only while the app is open and for a short grace after, so the
             receiver goes with RECEIVE_BOOT_COMPLETED above. -->
        <receiver
            android:name="app.tauri.backgroundservice.BootReceiver"
            tools:node="remove" />

        <!-- The plugin's self-managed Telecom service carries calls, and binds
             only with MANAGE_OWN_CALLS, which is dropped above. The plugin
             still registers its phone account at load; without the permission
             Telecom refuses it with a SecurityException the plugin catches. -->
        <service
            android:name="app.tauri.backgroundservice.BackgroundCallConnectionService"
            tools:node="remove" />
    </application>
</manifest>
