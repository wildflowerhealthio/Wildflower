{
  "openapi": "3.1.0",
  "info": {
    "title": "Wildflower Authorization OAuth API",
    "version": "0.0.0"
  },
  "paths": {
    "/.well-known/jwks.json": {
      "get": {
        "tags": [
          "Discovery"
        ],
        "summary": "`GET /.well-known/jwks.json` — serve the active public signing keys.",
        "operationId": "handle_jwks_request",
        "responses": {
          "200": {
            "description": "RFC 7517 JSON Web Key Set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Jwks"
                }
              }
            }
          }
        }
      }
    },
    "/authorization/clients": {
      "get": {
        "tags": [
          "Access management"
        ],
        "summary": "`GET /authorization/clients` — every registered OAuth client (seeded or trusted on first\nuse), disabled ones included, ordered by `clientId`. Acquired through\n[`LiveClientsReader`] (scope `wildflower/Client.r`).",
        "operationId": "handle_list_clients",
        "responses": {
          "200": {
            "description": "Every registered client",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClientBody"
                  }
                }
              }
            }
          },
          "403": {
            "description": "The caller's token doesn't cover the scope this operation requires",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InsufficientScopeBody"
                }
              }
            }
          }
        }
      }
    },
    "/authorization/clients/{clientId}": {
      "patch": {
        "tags": [
          "Access management"
        ],
        "summary": "`PATCH /authorization/clients/{clientId}` — disable (stamped with the server's now,\nwhatever time is sent) or re-enable a client by writing its `disabledAt`;\nanswers with the client as stored. A disabled client is refused at\n`/oauth/authorize` and `/oauth/token`. Idempotent (a client that already\nhas a `disabledAt` keeps it). Disabling an essential client — the host\napp's or the browser-session client — is refused with `409 EssentialClient`.\nAcquired through [`LiveClientsDisabler`] (scope `wildflower/Client.u`).",
        "operationId": "handle_update_client",
        "parameters": [
          {
            "name": "clientId",
            "in": "path",
            "description": "The client's `client_id`",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateClientBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The client as stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientBody"
                }
              }
            }
          },
          "403": {
            "description": "The caller's token doesn't cover the scope this operation requires",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InsufficientScopeBody"
                }
              }
            }
          },
          "404": {
            "description": "No client with that id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientNotFoundBody"
                }
              }
            }
          },
          "409": {
            "description": "The client is essential: disabling it would leave the Owner no way in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EssentialClientBody"
                }
              }
            }
          }
        }
      }
    },
    "/oauth/authorize": {
      "get": {
        "tags": [
          "OAuth 2.0"
        ],
        "summary": "The authorization endpoint (RFC 6749 §3.1), the public front door of the\nOAuth flow. Validates the request, then either auto-issues an authorization\ncode (when an existing grant pre-approves every requested scope) or parks\nthe user-agent on the authorization server's wait page while the Owner decides.",
        "description": "Nothing in-process calls this route. Registered clients (e.g.\nSMART-on-FHIR apps) discover it via the FHIR server's\n`.well-known/smart-configuration` (`authorization_endpoint`) and send the\n*user's browser* here with PKCE params to start an authorization-code\nflow:\n\n1. Browser lands here; the request is parked as an `AuthorizationRequest`\n   (5-minute TTL). A SMART App Launch's `aud` and `launch` are checked\n   first (see their fields), and the launch is consumed onto the request.\n2. Unless every requested scope is pre-approved by an existing grant for\n   this (client, `redirect_uri`) pair, the request joins the pending-consent\n   queue (raising the host webview's popup) and the browser is 302'd to a\n   page this authorization server serves beside the endpoint, on the origin\n   the browser used. A browser signed in as the Owner (it carries a live\n   browser session that can decide consents, and holds the request's\n   approval scopes) goes to the consent card at\n   `/oauth/authorize/{id}/consent`, where the Owner decides in place; the\n   request records that it can be decided there\n   (`decidable_in_requesting_browser`), and the browser session it was made\n   in (`sid`), which the code is issued under.\n   Any other goes to the wait page at `/oauth/authorize/{id}/wait`, which polls\n   `GET /oauth/authorize/{id}` (a custom extension, not part of any RFC)\n   until the Owner decides — in the popup, in a signed-in launcher, or on\n   the consent card once that browser signs in.\n   RFC 6749 leaves the owner-interaction mechanism unspecified, so both\n   pages are spec-legal; likewise §4.1 explicitly allows skipping consent\n   on a previously established authorization decision, which is what the\n   grant fast path implements.\n3. Approval 302s the browser back to the client's `redirect_uri` with\n   `code` + `state` (§4.1.2); the client then redeems the short-lived\n   code at `POST /oauth/token` (§4.1.3) with its PKCE verifier.\n\nClients other than the host app's are **trusted on first use**: an\nunknown `client_id`, an unregistered `redirect_uri`, and scopes outside the\nregistration are all carried to the Owner's prompt as a registration warning\nrather than rejected here, and nothing is written to the `clients` table\nuntil the Owner approves. Such a request never takes the grant fast path,\nand while its redirect is untrusted every other failure renders the local\nHTML page instead of redirecting. The host app's client keeps the strict\ntreatment, and a disabled client is rejected either way.",
        "operationId": "handle_authorize_request",
        "parameters": [
          {
            "name": "response_type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code_challenge_method",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "client_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "scope",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code_challenge",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "redirect_uri",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "launch",
            "in": "query",
            "description": "SMART App Launch `launch` value, handed to the app in its launch URL\nand forwarded here. It must name a launch this server minted for this\n`client_id` that is unused and unexpired (five minutes); it is consumed,\nso it works once, and the request carries the launch's context\n(including any patient it binds) to the consent. Any other value is\n`invalid_request`. Absent, the request is plain OAuth.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "aud",
            "in": "query",
            "description": "SMART App Launch audience: the FHIR server the app expects to call with\nthe token. When present it must be this server's origin\n(`https://<domain>`), which is also its FHIR base, else\n`invalid_request`. The minted token's `aud` is the server's origin.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the client redirect_uri, or to the authorization server's consent card (a browser signed in as the Owner) or wait page"
          },
          "400": {
            "description": "Local HTML error page (untrusted redirect_uri)"
          },
          "503": {
            "description": "No active signing key"
          }
        }
      }
    },
    "/oauth/authorize/{id}": {
      "get": {
        "tags": [
          "OAuth 2.0"
        ],
        "summary": "Return the current status of the pending authorization request, including\nthe final redirect URL once approved.",
        "description": "The error side is `axum::response::ErrorResponse` because two error shapes\nshare the handler: the Owner-surface `AuthorizationServerError` (its\n`AuthorizationRequestNotFound` 404 / logged 500) and the OAuth-shaped\n`OAuthErrorResponse` `server_error` — `?` converts either through its\n`IntoResponse`.",
        "operationId": "handle_authorization_status_request",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Authorization request id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current authorization-request status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorizationStatus"
                }
              }
            }
          },
          "404": {
            "description": "No authorization request with that id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorizationRequestNotFound"
                }
              }
            }
          },
          "500": {
            "description": "Server error (RFC 6749 §5.2)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          }
        }
      }
    },
    "/oauth/device_authorization": {
      "post": {
        "tags": [
          "OAuth 2.0"
        ],
        "summary": "Issue a `(device_code, user_code)` pair for the client to poll on while the\nuser pairs the device. `Ok` carries the §5.1 cache suppression via\n[`DeviceAuthorizationResponse`], `Err` via [`TokenError`].",
        "operationId": "handle_device_authorization_request",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/DeviceAuthorizationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Device + user code pair (RFC 8628 §3.2)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceAuthorizationResponse"
                }
              }
            }
          },
          "400": {
            "description": "OAuth error (RFC 6749 §5.2)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          },
          "401": {
            "description": "Client authentication failed (RFC 6749 §5.2)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          }
        }
      }
    },
    "/oauth/pair/poll": {
      "post": {
        "tags": [
          "Browser pairing"
        ],
        "summary": "Poll a browser pairing. The poll that finds it approved starts the\nbrowser's approved session and sets it as the browser's\n`__Host-browser_session` cookie.",
        "operationId": "handle_browser_pairing_poll",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BrowserPairingPollBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Where the pairing stands",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrowserPairingStatusBody"
                }
              }
            }
          },
          "404": {
            "description": "No pairing has the pairing code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrowserPairingNotFound"
                }
              }
            }
          }
        }
      }
    },
    "/oauth/pair/start": {
      "post": {
        "tags": [
          "Browser pairing"
        ],
        "summary": "Start a browser pairing for this browser, named after its `User-Agent`,\nand raise the Owner's notification.",
        "operationId": "handle_browser_pairing_start",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BrowserPairingStartBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The started pairing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartedBrowserPairingBody"
                }
              }
            }
          },
          "400": {
            "description": "`next` is no path on this server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrowserPairingRefused"
                }
              }
            }
          },
          "403": {
            "description": "The browser-session client is disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrowserPairingRefused"
                }
              }
            }
          }
        }
      }
    },
    "/oauth/revoke": {
      "post": {
        "tags": [
          "OAuth 2.0"
        ],
        "summary": "Revoke the presented token. RFC 7009 §2.2: `200` whether the token was\nrevoked, was already dead, or was never one of this client's.",
        "operationId": "handle_token_revocation_request",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/TokenRevocationRequestBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Revoked, or not a live token of this client's (RFC 7009 §2.2)"
          },
          "400": {
            "description": "Malformed request (RFC 7009 §2.2.1)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          },
          "401": {
            "description": "Client authentication failed (RFC 7009 §2.2.1)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          }
        }
      }
    },
    "/oauth/token": {
      "post": {
        "tags": [
          "OAuth 2.0"
        ],
        "summary": "Render the dispatch outcome — `Ok` carries the §5.1 cache suppression via\n[`TokenResponse`], `Err` via [`TokenError`].",
        "operationId": "handle_token_request",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequestBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful token response (RFC 6749 §5.1)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "OAuth error (RFC 6749 §5.2 / RFC 8628 §3.5)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          },
          "401": {
            "description": "Client authentication failed (RFC 6749 §5.2)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          },
          "500": {
            "description": "Server error (RFC 6749 §5.2)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthorizationRequestNotFound": {
        "type": "object",
        "description": "The JSON 404 body `not_found(\"AuthorizationRequestNotFound\", \"id\", ...)`\nrenders for an unknown authorization request.",
        "required": [
          "error",
          "id"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        }
      },
      "AuthorizationStatus": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "pending"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "redirect": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Client callback URL carrying `error=access_denied&state=...` for\ncode-flow requests (RFC 6749 §4.1.2.1) so the wait page can\ncomplete the flow. Absent for device-flow denials, which have no\nclient `redirect_uri`."
              },
              "status": {
                "type": "string",
                "enum": [
                  "denied"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "redirect",
              "status"
            ],
            "properties": {
              "redirect": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "approved"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "message",
              "status"
            ],
            "properties": {
              "message": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "error"
                ]
              }
            }
          }
        ],
        "description": "Polling response for the launcher watching an authorization request as it\nmoves from `Pending` toward approval or denial."
      },
      "BrowserPairingNotFound": {
        "type": "object",
        "description": "No browser pairing has the presented pairing code\n(`BrowserPairingNotFound`, 404).",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "BrowserPairingPollBody": {
        "type": "object",
        "description": "`POST /oauth/pair/poll` body.",
        "required": [
          "pairingCode",
          "browserName"
        ],
        "properties": {
          "pairingCode": {
            "type": "string",
            "description": "The pairing code the start answered with."
          },
          "browserName": {
            "type": "string",
            "description": "The name the page now gives its browser. Recorded while the request\nis pending; blank keeps the name it has."
          }
        }
      },
      "BrowserPairingRefused": {
        "type": "object",
        "description": "Why a pairing didn't start: `next` is no path on this server\n(`BrowserPairingNextNotAllowed`, 400), or the browser-session client is\ndisabled (`BrowserSessionClientDisabled`, 403).",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "BrowserPairingStartBody": {
        "type": "object",
        "description": "`POST /oauth/pair/start` body.",
        "required": [
          "next"
        ],
        "properties": {
          "next": {
            "type": "string",
            "description": "Where the browser goes once it holds its session: a path on this\nserver, in practice an `/oauth/authorize` URL."
          }
        }
      },
      "BrowserPairingStatusBody": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "pending"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "slow_down"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "approved"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "denied"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "expired"
                ]
              }
            }
          }
        ],
        "description": "Where a pairing stands. `approved` carries the browser's session as its\n`Set-Cookie`; the page then goes on to its `next`. `slow_down` means the\npage polled sooner than its interval."
      },
      "ClientBody": {
        "type": "object",
        "description": "A registered OAuth client as the Owner's \"Trusted apps\" list reads it. Every\ncolumn of the `clients` row **except `secret_hash`**, which never leaves the\nserver, plus `essential` — whether this is the host app's client or the\nbrowser-session client, which can't be disabled.",
        "required": [
          "clientId",
          "name",
          "kind",
          "redirectUris",
          "allowedScopes",
          "allowedGrantTypes",
          "registeredAt",
          "disabledAt",
          "essential"
        ],
        "properties": {
          "clientId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "description": "`public` or `confidential`."
          },
          "redirectUris": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Absolute redirect URLs, matched exactly at `/oauth/authorize`."
          },
          "allowedScopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowedGrantTypes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The `grant_type` values the client may use at `/oauth/token`."
          },
          "registeredAt": {
            "type": "string",
            "format": "date-time"
          },
          "disabledAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Set while the client is disabled; `null` when it is enabled."
          },
          "essential": {
            "type": "boolean"
          }
        }
      },
      "ClientNotFoundBody": {
        "type": "object",
        "description": "Wire shape for `ClientNotFound` (404) — no registered client has this\n`client_id`.",
        "required": [
          "error",
          "clientId"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Always `\"ClientNotFound\"`."
          },
          "clientId": {
            "type": "string"
          }
        }
      },
      "DeviceAuthorizationRequest": {
        "type": "object",
        "description": "`POST /oauth/device_authorization` request body (RFC 8628 §3.1) — the\noptional `scope` plus the body credentials, and the non-standard\n`device_name` extension. Form-urlencoded.",
        "properties": {
          "client_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "client_secret": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "type": [
              "string",
              "null"
            ]
          },
          "device_name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "DeviceAuthorizationResponse": {
        "type": "object",
        "description": "Body returned by `/oauth/device_authorization` per RFC 8628 §3.2.",
        "required": [
          "device_code",
          "user_code",
          "verification_uri",
          "verification_uri_complete",
          "expires_in",
          "interval"
        ],
        "properties": {
          "device_code": {
            "type": "string"
          },
          "user_code": {
            "type": "string"
          },
          "verification_uri": {
            "type": "string",
            "description": "This server's device verification page, `{origin}/oauth/device`."
          },
          "verification_uri_complete": {
            "type": "string",
            "description": "The device verification page with the code filled in,\n`{origin}/oauth/device?user_code={user_code}`. The Owner still confirms\nthe code before the page reads the request."
          },
          "expires_in": {
            "type": "integer",
            "format": "int64"
          },
          "interval": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "EssentialClientBody": {
        "type": "object",
        "description": "Wire shape for `EssentialClient` (409) — the named client is essential:\ndisabling it would leave the Owner no way in.",
        "required": [
          "error",
          "clientId"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Always `\"EssentialClient\"`."
          },
          "clientId": {
            "type": "string"
          }
        }
      },
      "InsufficientScopeBody": {
        "type": "object",
        "description": "Wire shape for a 403 — the caller authenticated, but their token doesn't cover\nthe scope(s) an operation requires. `missingScopes` names the scopes the\ncaller must additionally hold.",
        "required": [
          "error",
          "missingScopes"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Always `\"InsufficientScope\"` — the discriminant a client switches on."
          },
          "missingScopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The rendered scopes the caller lacks."
          }
        }
      },
      "Jwks": {
        "type": "object",
        "description": "RFC 7517 JSON Web Key Set body served at `/.well-known/jwks.json`.",
        "required": [
          "keys"
        ],
        "properties": {
          "keys": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicJwk"
            }
          }
        }
      },
      "OAuthError": {
        "type": "object",
        "description": "RFC 6749 §5.2 token-endpoint error body.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "error_description": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "PublicJwk": {
        "type": "object",
        "required": [
          "kid",
          "kty",
          "alg",
          "key_ops",
          "n",
          "e"
        ],
        "properties": {
          "kid": {
            "type": "string",
            "description": "Key identifier matching the source `SigningKey.kid`; verifiers use this to select the key."
          },
          "kty": {
            "type": "string",
            "description": "JWK key type — always `\"RSA\"`."
          },
          "alg": {
            "type": "string",
            "description": "JWS algorithm the key is intended for — always `\"RS256\"`."
          },
          "key_ops": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Permitted JWK operations — always `[\"verify\"]` for published public keys."
          },
          "n": {
            "type": "string",
            "description": "RSA modulus `n`, base64url-encoded."
          },
          "e": {
            "type": "string",
            "description": "RSA public exponent `e`, base64url-encoded."
          }
        }
      },
      "StartedBrowserPairingBody": {
        "type": "object",
        "description": "A started pairing, for the pairing page.",
        "required": [
          "pairingCode",
          "userCode",
          "browserName",
          "next",
          "expiresIn",
          "interval"
        ],
        "properties": {
          "pairingCode": {
            "type": "string",
            "description": "The secret the page polls with. Only this page holds it."
          },
          "userCode": {
            "type": "string",
            "description": "The code the page shows, which the Owner confirms on the device page."
          },
          "browserName": {
            "type": "string",
            "description": "The name the browser goes by until the page names it, taken from its\nuser agent."
          },
          "next": {
            "type": "string",
            "description": "Where the page sends the browser once it holds its session: `next`,\nresolved against this server."
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64",
            "description": "Seconds until the request expires."
          },
          "interval": {
            "type": "integer",
            "format": "int64",
            "description": "Seconds the page waits between polls."
          }
        }
      },
      "TokenRequestBody": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "code",
              "code_verifier",
              "redirect_uri",
              "grant_type"
            ],
            "properties": {
              "client_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "client_secret": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "code": {
                "type": "string"
              },
              "code_verifier": {
                "type": "string"
              },
              "redirect_uri": {
                "type": "string"
              },
              "grant_type": {
                "type": "string",
                "enum": [
                  "authorization_code"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "device_code",
              "grant_type"
            ],
            "properties": {
              "client_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "client_secret": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "device_code": {
                "type": "string"
              },
              "grant_type": {
                "type": "string",
                "enum": [
                  "urn:ietf:params:oauth:grant-type:device_code"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "refresh_token",
              "grant_type"
            ],
            "properties": {
              "client_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "client_secret": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "refresh_token": {
                "type": "string"
              },
              "grant_type": {
                "type": "string",
                "enum": [
                  "refresh_token"
                ]
              }
            }
          }
        ],
        "description": "`POST /oauth/token` request body — the `grant_type`-tagged union of the\nthree grants the endpoint dispatches (mirrors\n`super::token_exchange::TokenPayload` plus the body credentials).\nForm-urlencoded (RFC 6749 §3.2). `client_id`/`client_secret` are optional:\na confidential client may instead authenticate via `Authorization: Basic`\n(RFC 6749 §2.3.1) and omit them from the body — `resolve_client_credentials`\naccepts either source."
      },
      "TokenResponse": {
        "type": "object",
        "description": "RFC 6749 §5.1 successful token-endpoint response.",
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "scope"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string"
          },
          "expires_in": {
            "type": "integer",
            "format": "int64"
          },
          "scope": {
            "type": "string"
          },
          "refresh_token": {
            "type": [
              "string",
              "null"
            ],
            "description": "Present only when the grant carries [`wildflowerhealthio_scopes::KnownScope::OfflineAccess`]\n— the plaintext of the freshly-minted refresh-token generation (RFC 6749\n§5.1; only its hash is persisted)."
          },
          "patient": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "TokenRevocationRequestBody": {
        "type": "object",
        "description": "`POST /oauth/revoke` request body (RFC 7009 §2.1) — the token plus the\nbody credentials. Form-urlencoded. `token_type_hint` is accepted and not\nread: the server tells the token's type from the token.",
        "required": [
          "token"
        ],
        "properties": {
          "client_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "client_secret": {
            "type": [
              "string",
              "null"
            ]
          },
          "token": {
            "type": "string"
          },
          "token_type_hint": {
            "type": [
              "string",
              "null"
            ],
            "description": "`access_token` or `refresh_token`."
          }
        }
      },
      "UpdateClientBody": {
        "type": "object",
        "description": "Body of `PATCH /authorization/clients/{clientId}` — the one client field the Owner\ncan edit.",
        "required": [
          "disabledAt"
        ],
        "properties": {
          "disabledAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Any time to disable the client now, or `null` to re-enable it. The\nserver stamps its own now whatever time is sent, so a disable can't be\nscheduled or backdated. Required, `null` included."
          }
        },
        "additionalProperties": false
      }
    }
  }
}
