# systemd unit for wildflower-relay on a plain host (e.g. a droplet).
#
# Install:
#   1. Build and copy the binary:
#        cargo build --release --locked -p wildflower-relay
#        sudo install -m 0755 target/release/wildflower-relay /usr/local/bin/
#   2. Write the settings, readable by root only, starting from
#      relay.example.env (it lists every variable):
#        sudo install -d -m 0755 /etc/wildflower-relay
#        sudo install -m 0600 apps/wildflower-relay/relay.example.env /etc/wildflower-relay/env
#        sudoedit /etc/wildflower-relay/env
#      Set WILDFLOWER_RELAY_DOMAIN, WILDFLOWER_RELAY_NOISE_PRIVATE_KEY and one
#      WILDFLOWER_RELAY_SERVICES entry per device. After changing it:
#        sudo systemctl restart wildflower-relay
#   3. Install and start the unit:
#        sudo install -m 0644 apps/wildflower-relay/wildflower-relay.service /etc/systemd/system/
#        sudo systemctl daemon-reload
#        sudo systemctl enable --now wildflower-relay
#
# The environment file is the relay's only configuration (see
# relay.example.env). On each start the relay renders a fresh rathole TOML to
# /run/wildflower-relay/relay.toml, which systemd removes when it stops.

[Unit]
Description=Wildflower relay (rathole tunnels and SNI front)
Documentation=https://github.com/wildflowerhealthio/Wildflower/tree/main/apps/wildflower-relay
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/wildflower-relay
EnvironmentFile=/etc/wildflower-relay/env
Environment=WILDFLOWER_RELAY_CONFIG=/run/wildflower-relay/relay.toml
Restart=on-failure
RestartSec=2

# Unprivileged, with only the right to bind 443 and 80.
DynamicUser=yes
RuntimeDirectory=wildflower-relay
RuntimeDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LimitNOFILE=65536

# Hardening.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# rathole raises its open-file limit at start (setrlimit), so @resources stays allowed.
SystemCallFilter=~@privileged
UMask=0077

[Install]
WantedBy=multi-user.target
