# Example environment for wildflower-relay. Every setting lives here; the
# state directory holds only caches. On a host it goes in
# /etc/wildflower-relay/env (mode 0600, read by wildflower-relay.service).
# Lines starting `# ` show optional variables at their defaults.
#
# At each start the relay writes a fresh rathole TOML from these values to
# WILDFLOWER_RELAY_CONFIG and runs rathole and the TLS front from it.

# Where the generated rathole TOML is written. The systemd unit sets
# /run/wildflower-relay/relay.toml.
# WILDFLOWER_RELAY_CONFIG=relay.toml

# Where the relay keeps its caches: the ACME account and the certificate for
# its own hostname, under `acme/`. Relative paths are from the working
# directory. The systemd unit sets /var/lib/wildflower-relay.
# WILDFLOWER_RELAY_STATE_DIR=relay-state

# --- Tunnels (rathole) -------------------------------------------------------

# Noise private key from `rathole --genkey`. The matching public key goes into
# each device's rathole client config as `remote_public_key`. The all-zero
# placeholder is valid base64 so this example parses; it is not secret.
WILDFLOWER_RELAY_NOISE_PRIVATE_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# One `name=token` tunnel per device, comma separated. The tunnel name is the
# device's subdomain (`https://<tunnel name>.<WILDFLOWER_RELAY_DOMAIN>`) and
# must be a lowercase DNS label; the token is that tunnel's own rathole token
# (each tunnel is a rathole service of the same name). There is no shared
# token. Unset or empty means no tunnels.
WILDFLOWER_RELAY_TUNNELS=wildflower-device-1=CHANGE_ME_per_device_secret

# Loopback port of the first tunnel; the rest follow in name order.
# WILDFLOWER_RELAY_TUNNEL_PORT_BASE=5201

# Where devices' rathole clients connect.
# WILDFLOWER_RELAY_CONTROL_ADDR=0.0.0.0:2333

# --- TLS front ---------------------------------------------------------------

# Public domain suffix: `<tunnel name>.<domain>` routes to that tunnel. The
# domain itself is the relay's own hostname: the relay terminates TLS for it
# with a Let's Encrypt certificate and serves `GET /health` there.
WILDFLOWER_RELAY_DOMAIN=relay.example.com

# Listen addresses for TLS routing by server name and the redirect to https.
# WILDFLOWER_RELAY_HTTPS_ADDR=0.0.0.0:443
# WILDFLOWER_RELAY_HTTP_ADDR=0.0.0.0:80

# Concurrent connections across both ports.
# WILDFLOWER_RELAY_MAX_CONNECTIONS=4096

# Seconds to wait for a ClientHello (or HTTP request head), and for the
# relay's own site to finish a TLS handshake.
# WILDFLOWER_RELAY_HELLO_TIMEOUT_SECS=5

# --- Certificate for the relay's own hostname (ACME) -------------------------

# `true` orders from Let's Encrypt's staging directory: certificates browsers
# do not trust, under much higher rate limits. For trying out a new host.
# WILDFLOWER_RELAY_ACME_STAGING=false

# The ACME account's contact, the operator's `mailto:` address (for example
# mailto:ops@example.com). Unset registers the account without a contact.

# Logging, e.g. `info` or `wildflower_relay=debug,info`.
# RUST_LOG=info
