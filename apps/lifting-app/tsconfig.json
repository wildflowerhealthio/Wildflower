{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    // Resolve workspace packages through their `source` export, the same
    // condition `vite.config.base.ts` sets — as `apps/wildflower-react` does.
    // Without it `tsc` reads each package's rolled-up `dist/*.d.ts`, where an
    // inlined `QueryClient` declaration is a *different* type from the one
    // `@tanstack/react-query` exports, and handing the page's `QueryClient` to
    // `fhir-r4-react/smart`'s `buildSmartRouterContext` stops typechecking.
    "customConditions": ["source"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "noEmit": true,

    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}
