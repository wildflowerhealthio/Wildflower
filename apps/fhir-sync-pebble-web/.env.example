# Copy to .env.local and fill in values. Committed values must remain empty.
#
# Sentry runtime config for this app. Vite inlines `VITE_*` keys into the
# bundle at build time. Nothing is reported until the visitor says yes in the
# consent dialog. `VITE_SENTRY_DSN_FHIR_SYNC_PEBBLE_WEB` is read in `src/config.ts`;
# the rest are read by `configFromViteEnv` in `telemetry-web`.
#
# When `VITE_SENTRY_DSN_FHIR_SYNC_PEBBLE_WEB` is empty, the app reports nothing whatever
# the visitor answers. The shared `VITE_SENTRY_DSN` is never read in its place.

VITE_SENTRY_DSN_FHIR_SYNC_PEBBLE_WEB=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
