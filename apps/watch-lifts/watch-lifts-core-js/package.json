{
  "name": "@wildflowerhealthio/watch-lifts-core-js",
  "version": "0.0.0",
  "private": true,
  "description": "Pure core of WatchLifts' phone settings: the exercises, the people and their default weights, the weights the settings page edits (an Effect Schema, and its JSON), and, as the Effect-free `./pkjs` entry, what the watchapp's PebbleKit JS decodes from the page, keeps and sends the watch. No DOM, no platform imports.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./pkjs": {
      "source": "./src/pkjs.ts",
      "default": "./dist/pkjs.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@wildflowerhealthio/kitchen-sink": "workspace:*",
    "@wildflowerhealthio/pebble-configuration": "workspace:*",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "typescript-7": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@wildflowerhealthio/pebble-configuration": "workspace:*",
    "effect": "catalog:"
  }
}
