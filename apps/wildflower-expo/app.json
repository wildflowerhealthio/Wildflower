{
  "expo": {
    "name": "Wildflower",
    "slug": "wildflower-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "wildflower-expo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#fdf4e3"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.wildflower.wildflower-expo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fdf4e3"
      },
      "package": "dev.wildflower.wildflowerexpo",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-build-properties",
      "expo-router",
      "expo-splash-screen",
      [
        "expo-file-system",
        {
          "enableFileSharing": true
        }
      ],
      "expo-asset",
      "expo-sqlite",
      "expo-web-browser",
      "expo-font",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "wildflower-react-native",
          "organization": "ruth-marks"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": true
          },
          "android": {
            "newArchEnabled": true
          }
        }
      ],
      "react-native-quick-crypto"
    ],
    "owner": "wildflower-health-informatics",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d9a8bdff-dd10-41b4-80e0-da08ca367384"
      }
    }
  }
}
