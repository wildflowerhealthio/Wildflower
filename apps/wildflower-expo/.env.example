# Copy to .env.local and fill in values. Committed values must remain empty.
#
# Sentry + OpenTelemetry runtime config for the Expo app. Metro inlines
# `EXPO_PUBLIC_*` keys into the bundle at build time — read by
# `configFromExpoEnv` in `telemetry-react-native`.
#
# When `EXPO_PUBLIC_SENTRY_DSN` is empty, Sentry is initialized in
# disabled mode (so `Sentry.wrap` is safe) but emits a console warning.

EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
EXPO_PUBLIC_SENTRY_RELEASE=
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1.0
EXPO_PUBLIC_SENTRY_PROFILES_SAMPLE_RATE=0.0

# Default mirrors `SERVICE_NAME` in `src/constants.ts`.
EXPO_PUBLIC_OTEL_SERVICE_NAME=wildflower-expo
EXPO_PUBLIC_OTEL_SERVICE_VERSION=0.0.0
# Optional: additional OTLP trace exporter endpoint (e.g. a local collector).
# Sentry receives spans unconditionally when EXPO_PUBLIC_SENTRY_DSN is set.
EXPO_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=
