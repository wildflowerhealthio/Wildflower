# Copy to .env.local and fill in values. Committed values must remain empty.
#
# Sentry + OpenTelemetry runtime config for the Node backend.
# Telemetry stays inert if SENTRY_DSN is empty.

SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Default mirrors `SERVICE_NAME` in `src/service-name.ts`.
OTEL_SERVICE_NAME=wildflower-node
OTEL_SERVICE_VERSION=0.0.0
# Optional: additional OTLP trace exporter endpoint (e.g. a local collector).
# Sentry receives spans unconditionally when SENTRY_DSN is set.
OTEL_EXPORTER_OTLP_ENDPOINT=
