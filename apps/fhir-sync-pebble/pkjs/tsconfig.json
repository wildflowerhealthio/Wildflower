{
  "compilerOptions": {
    "target": "es2015",
    "lib": ["es5"],
    "types": [],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "customConditions": ["source"],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
