{
  "version": 1,
  "apps": [
    {
      "id": "medications",
      "name": "Medication Viewer",
      "description": "Every prescription on a patient's FHIR record, arranged around refill day, from any server that speaks SMART on FHIR.",
      "launchUrl": "https://medications.wildflowerhealth.io/",
      "publisher": {
        "kind": "first-party",
        "name": "Wildflower Health"
      },
      "tags": ["medications"],
      "scopes": [
        "launch",
        "openid",
        "fhirUser",
        "system/MedicationRequest.rs",
        "system/Medication.rs",
        "system/Patient.rs"
      ]
    },
    {
      "id": "plots",
      "name": "Plots",
      "description": "Plots labs, vitals and prescribed doses from a patient's FHIR record on one chart, so a dose change can be read against the numbers it is meant to move.",
      "launchUrl": "https://plots.wildflowerhealth.io/",
      "publisher": {
        "kind": "first-party",
        "name": "Wildflower Health"
      },
      "tags": ["charts", "lab-results", "vitals", "medications"],
      "scopes": [
        "launch",
        "openid",
        "fhirUser",
        "system/Observation.rs",
        "system/MedicationRequest.rs",
        "system/Patient.rs"
      ]
    },
    {
      "id": "strength",
      "name": "Strength",
      "description": "A strength-training program, the workout due today and every set you lift, kept on your own FHIR record.",
      "launchUrl": "https://strength.wildflowerhealth.io/",
      "publisher": {
        "kind": "first-party",
        "name": "Wildflower Health"
      },
      "tags": ["fitness"],
      "scopes": [
        "launch",
        "openid",
        "fhirUser",
        "system/Patient.rs",
        "system/PlanDefinition.crus",
        "system/ServiceRequest.crus",
        "system/Procedure.crus",
        "system/Observation.crus"
      ]
    },
    {
      "id": "importer",
      "name": "Importer",
      "description": "Turns what your browser saw on a pharmacy, lab, or patient-portal website into FHIR records on a server you control.",
      "launchUrl": "https://importer.wildflowerhealth.io/",
      "publisher": {
        "kind": "first-party",
        "name": "Wildflower Health"
      },
      "tags": ["data-import", "medications", "lab-results"],
      "scopes": [
        "launch",
        "openid",
        "fhirUser",
        "system/DocumentReference.cruds",
        "system/Patient.cruds",
        "system/Observation.cruds",
        "system/Practitioner.cruds",
        "system/DiagnosticReport.cruds",
        "system/Medication.cruds",
        "system/MedicationRequest.cruds",
        "system/MedicationDispense.cruds",
        "system/ServiceRequest.cruds",
        "system/ImagingStudy.cruds"
      ]
    },
    {
      "id": "synthetic-data",
      "name": "Synthetic Data Loader",
      "description": "Loads a published snapshot of synthetic health records into a FHIR server, so the other apps have a realistic record to show.",
      "launchUrl": "https://synthetic-data.wildflowerhealth.io/",
      "publisher": {
        "kind": "first-party",
        "name": "Wildflower Health"
      },
      "tags": ["test-data", "developer"],
      "scopes": [
        "launch",
        "openid",
        "fhirUser",
        "system/Patient.cu",
        "system/Practitioner.cu",
        "system/DocumentReference.cu",
        "system/Observation.cu",
        "system/DiagnosticReport.cu",
        "system/Medication.cu",
        "system/MedicationRequest.cu",
        "system/MedicationDispense.cu",
        "system/ServiceRequest.cu",
        "system/ImagingStudy.cu"
      ]
    },
    {
      "id": "ohif-viewer",
      "name": "Imaging",
      "description": "Views a patient's imaging studies and scanned documents in the OHIF viewer.",
      "launchUrl": "https://ohif-viewer.wildflowerhealth.io/fhir-viewer",
      "publisher": {
        "kind": "first-party",
        "name": "Wildflower Health"
      },
      "tags": ["imaging"],
      "scopes": [
        "launch",
        "openid",
        "fhirUser",
        "system/Patient.rs",
        "system/ImagingStudy.rs",
        "system/DocumentReference.rs"
      ]
    },
    {
      "id": "growth-chart",
      "name": "SMART Growth Chart",
      "description": "Plots a child's height, weight and head circumference against standard growth curves.",
      "launchUrl": "https://examples.smarthealthit.org/growth-chart-app/launch.html",
      "publisher": {
        "kind": "third-party",
        "name": "SMART Health IT"
      },
      "tags": ["pediatrics", "vitals", "charts"],
      "scopes": ["patient/Observation.read", "patient/Patient.read", "offline_access"]
    },
    {
      "id": "smart-on-fhir-demo",
      "name": "SMART on FHIR Demo",
      "description": "A small demo that lists a patient's medications. Useful for checking that a server's SMART launch works.",
      "launchUrl": "https://mitre.github.io/smart-on-fhir-demo/launch.html",
      "publisher": {
        "kind": "third-party",
        "name": "MITRE"
      },
      "tags": ["medications", "developer"],
      "scopes": ["launch", "openid", "fhirUser", "patient/*.read"]
