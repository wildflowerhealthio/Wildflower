# Copy to .env.local and fill in values. Committed values must remain empty.
#
# Sentry + OpenTelemetry runtime config. Vite inlines `VITE_*` keys into the
# bundle at build time.
#
# Both entries (`main-web`, the published owner UI, and `main-tauri`, the
# Tauri host's webview) report nothing until the user says yes in the consent
# dialog, and then to the owner UI's own project:
# `VITE_SENTRY_DSN_WILDFLOWER_REACT`, read in
# `src/session/consented-entry-root.tsx`. When it is empty, the entry reports
# nothing whatever the user answers; the shared `VITE_SENTRY_DSN` is never read
# in its place. The Tauri build reads its `VITE_*` variables from
# `apps/wildflower-tauri`'s environment, not this directory's.
#
# The rest are read by `configFromViteEnv` in `telemetry-web`, for both entries.

VITE_SENTRY_DSN_WILDFLOWER_REACT=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
VITE_SENTRY_PROFILES_SAMPLE_RATE=0.0

# The OpenTelemetry resource. Both entries name their service
# `wildflower-react` whatever this says.
VITE_OTEL_SERVICE_NAME=wildflower-react
VITE_OTEL_SERVICE_VERSION=0.0.0
