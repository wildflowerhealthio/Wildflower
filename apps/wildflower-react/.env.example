# Copy to .env.local and fill in values. Committed values must remain empty.
#
# Sentry + OpenTelemetry runtime config for the web app. Vite inlines
# `VITE_*` keys into the bundle at build time — read by
# `configFromViteEnv` in `telemetry-web`.
#
# When `VITE_SENTRY_DSN` is empty, Sentry is initialized in
# disabled mode (so `Sentry.wrap` is safe) but emits a console warning.

VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
VITE_SENTRY_PROFILES_SAMPLE_RATE=0.0

# Default mirrors `SERVICE_NAME` in `src/constants.ts`.
VITE_OTEL_SERVICE_NAME=wildflower-react
VITE_OTEL_SERVICE_VERSION=0.0.0
# Optional: additional OTLP trace exporter endpoint (e.g. a local collector).
# Sentry receives spans unconditionally when VITE_SENTRY_DSN is set.
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=
