# Copy to .env.local and fill in values. Committed values must remain empty.
#
# Sentry + OpenTelemetry runtime config. Vite inlines `VITE_*` keys into the
# bundle at build time.
#
# The web entry (`main-web`, the published owner UI) reports nothing until the
# visitor says yes in the consent dialog, and then to its own project:
# `VITE_SENTRY_DSN_WILDFLOWER_REACT`, read in `src/session/web-entry-root.tsx`.
# When it is empty, the web entry reports nothing whatever the visitor answers;
# the shared `VITE_SENTRY_DSN` is never read in its place.
#
# The Tauri entry (`main-tauri`) reads the shared `VITE_SENTRY_DSN` through
# `src/instrument.ts` and starts telemetry without asking. When it is empty,
# Sentry is initialized in disabled mode (so `Sentry.wrap` is safe) but emits a
# console warning.
#
# The rest are read by `configFromViteEnv` in `telemetry-web`, for both entries.

VITE_SENTRY_DSN_WILDFLOWER_REACT=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
VITE_SENTRY_PROFILES_SAMPLE_RATE=0.0

# The OpenTelemetry resource. The web entry names its service
# `wildflower-react` whatever this says.
VITE_OTEL_SERVICE_NAME=wildflower-react
VITE_OTEL_SERVICE_VERSION=0.0.0
# Optional: additional OTLP trace exporter endpoint (e.g. a local collector),
# for the Tauri entry. The web entry's consent never turns it on. Sentry
# receives the Tauri entry's spans unconditionally when VITE_SENTRY_DSN is set.
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=
