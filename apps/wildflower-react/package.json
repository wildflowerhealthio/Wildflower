{
  "name": "wildflower-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./embeddable-html": {
      "types": "./dist-embedded/html.d.ts",
      "default": "./dist-embedded/html.js"
    },
    "./web-assets-dir": {
      "source": "./src/web-assets-dir.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp run build:embedded && vp run build:web",
    "build:embedded": "vp build --config vite.config.embedded.ts",
    "build:web": "vp build --config vite.config.web.ts",
    "check": "vp check",
    "dev": "vp dev --config vite.config.web.ts"
  },
  "dependencies": {
    "gatekeeper-web": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "^7.8.0",
    "react-tundraish": "workspace:*",
    "telemetry-web": "workspace:*",
    "tundra-css": "^0.14.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "~19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "catalog:",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-plus": "catalog:"
  }
}
