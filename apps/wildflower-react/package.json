{
  "name": "wildflower-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./embeddable-html": {
      "source": "./src/embeddable-html-stub.ts",
      "types": "./dist-embedded/html.d.ts",
      "default": "./dist-embedded/html.js"
    },
    "./app-root": {
      "source": "./src/app-root.tsx",
      "types": "./dist/app-root.d.ts",
      "default": "./dist/app-root.js"
    },
    "./web-entry": {
      "source": "./src/web-entry.ts",
      "types": "./dist/web-entry.d.ts",
      "default": "./dist/web-entry.js"
    },
    "./os-color-scheme-listener": {
      "source": "./src/styles/add-os-color-scheme-listener.ts",
      "types": "./dist/os-color-scheme-listener.d.ts",
      "default": "./dist/os-color-scheme-listener.js"
    },
    "./instrument": {
      "source": "./src/instrument.ts",
      "types": "./dist/instrument.d.ts",
      "default": "./dist/instrument.js"
    },
    "./single-web-html": {
      "source": "./src/single-web-html-stub.ts",
      "types": "./dist-single-web/html.d.ts",
      "default": "./dist-single-web/html.js"
    },
    "./web-assets": {
      "source": "./src/web-assets.ts"
    },
    "./bridges": {
      "source": "./src/bridges/bridges.ts"
    },
    "./global.css": {
      "source": "./src/styles/global.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp run build:embedded && vp run build:single-web && vp run build:web",
    "build:embedded": "vp build --config vite.config.embedded.ts",
    "build:single-web": "vp build --config vite.config.single-web.ts",
    "build:web": "vp build --config vite.config.web.ts",
    "check": "vp check",
    "dev": "vp dev --config vite.config.web.ts",
    "test": "vp test --passWithNoTests"
  },
  "dependencies": {
    "@effect/platform": "catalog:",
    "@fontsource-variable/hanken-grotesk": "catalog:",
    "@fontsource-variable/newsreader": "catalog:",
    "@fontsource-variable/spline-sans-mono": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "apps-core": "workspace:*",
    "apps-react": "workspace:*",
    "collector-core": "workspace:*",
    "collector-fundamentals": "workspace:*",
    "collector-react": "workspace:*",
    "databases-react": "workspace:*",
    "effect": "catalog:",
    "effect-messaging-core": "workspace:*",
    "effect-messaging-react": "workspace:*",
    "fhir-r4": "workspace:*",
    "fhir-r4-react": "workspace:*",
    "gatekeeper-core": "workspace:*",
    "gatekeeper-react": "workspace:*",
    "kitchen-sink": "workspace:*",
    "navigation-core": "workspace:*",
    "navigation-react": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-kitchen-sink": "workspace:*",
    "react-tundraish": "workspace:*",
    "shared-structures-react": "workspace:*",
    "telemetry-react": "workspace:*",
    "telemetry-web": "workspace:*",
    "tundra-css": "catalog:",
    "tunnel-core": "workspace:*",
    "tunnel-react": "workspace:*"
  },
  "devDependencies": {
    "@effect/platform": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@tanstack/virtual-file-routes": "catalog:",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-plus": "catalog:"
  }
}
