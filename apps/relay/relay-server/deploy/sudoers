# sudoers rules for the `deploy` user on the relay host, installed as
# /etc/sudoers.d/wildflower-relay. On the host:
#
#   curl -fsSL -o /tmp/wildflower-relay.sudoers \
#     https://raw.githubusercontent.com/wildflowerhealthio/Wildflower/main/apps/relay/relay-server/deploy/sudoers
#   sudo visudo -cf /tmp/wildflower-relay.sudoers \
#     && sudo install -m 0440 -o root -g root /tmp/wildflower-relay.sudoers /etc/sudoers.d/wildflower-relay
#
# They allow exactly the commands install.sh runs for
# .github/workflows/deploy-relay.yml, with these arguments and no others.
# New files are written, and the uploaded environment file compared, through
# /dev/stdin, so root never reads a path the deploy user controls.
#
# Nothing here installs the systemd unit: a unit can run any command as root,
# so permission to write one would be root. The operator installs the unit,
# and install.sh stops before changing anything if it differs from the
# repository's. What remains controls only the relay's binary and
# environment, which run as the unit's unprivileged dynamic user. The binary
# lives in /opt/wildflower-relay, off root's PATH, so a root shell never runs
# it by name.
#
# WILDFLOWER_RELAY_RETIRE migrates a host from the relay's earlier unit,
# wildflower-relay.service: install.sh stops, disables and removes it before
# the new unit starts, keeps its binary as the rollback, and deletes the
# binary once the new build is up. It can only stop the earlier relay and
# remove its files.

Cmnd_Alias WILDFLOWER_RELAY_FILES = \
  /usr/bin/install -d -m 0755 -o root -g root /etc/wildflower-relay, \
  /usr/bin/install -m 0600 -o root -g root /dev/stdin /etc/wildflower-relay/env, \
  /usr/bin/install -d -m 0755 -o root -g root /opt/wildflower-relay, \
  /usr/bin/install -m 0755 -o root -g root /dev/stdin /opt/wildflower-relay/wildflowerhealthio-relay-server.new, \
  /usr/bin/mv -f /opt/wildflower-relay/wildflowerhealthio-relay-server.new /opt/wildflower-relay/wildflowerhealthio-relay-server, \
  /usr/bin/install -m 0755 -o root -g root /opt/wildflower-relay/wildflowerhealthio-relay-server /opt/wildflower-relay/wildflowerhealthio-relay-server.prev, \
  /usr/bin/install -m 0600 -o root -g root /etc/wildflower-relay/env /etc/wildflower-relay/env.prev, \
  /usr/bin/install -m 0755 -o root -g root /opt/wildflower-relay/wildflowerhealthio-relay-server.prev /opt/wildflower-relay/wildflowerhealthio-relay-server, \
  /usr/bin/install -m 0600 -o root -g root /etc/wildflower-relay/env.prev /etc/wildflower-relay/env, \
  /usr/bin/cmp -s /dev/stdin /etc/wildflower-relay/env

Cmnd_Alias WILDFLOWER_RELAY_SERVICE = \
  /usr/bin/systemctl enable wildflowerhealthio-relay-server, \
  /usr/bin/systemctl reset-failed wildflowerhealthio-relay-server, \
  /usr/bin/systemctl restart wildflowerhealthio-relay-server, \
  /usr/bin/journalctl -u wildflowerhealthio-relay-server -n 50 --no-pager

Cmnd_Alias WILDFLOWER_RELAY_RETIRE = \
  /usr/bin/systemctl disable --now wildflower-relay, \
  /usr/bin/rm -f /etc/systemd/system/wildflower-relay.service, \
  /usr/bin/systemctl daemon-reload, \
  /usr/bin/install -m 0755 -o root -g root /opt/wildflower-relay/wildflower-relay /opt/wildflower-relay/wildflowerhealthio-relay-server.prev, \
  /usr/bin/rm -f /opt/wildflower-relay/wildflower-relay /opt/wildflower-relay/wildflower-relay.prev

deploy ALL=(root) NOPASSWD: WILDFLOWER_RELAY_FILES, WILDFLOWER_RELAY_SERVICE, WILDFLOWER_RELAY_RETIRE
