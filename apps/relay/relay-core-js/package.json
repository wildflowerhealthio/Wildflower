{
  "name": "relay-core-js",
  "version": "0.0.0",
  "private": true,
  "description": "The relay admin API (HttpApi definition and client), the RFC 9421 request signer and the admin key store.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wildflowerhealthio/Wildflower.git",
    "directory": "apps/relay/relay-core-js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./clients": {
      "source": "./src/clients/index.ts",
      "default": "./dist/clients/index.js"
    },
    "./http-api-definition": {
      "source": "./src/http-api-definition/index.ts",
      "default": "./dist/http-api-definition/index.js"
    },
    "./key-store": {
      "source": "./src/key-store/index.ts",
      "default": "./dist/key-store/index.js"
    },
    "./signing": {
      "source": "./src/signing/index.ts",
      "default": "./dist/signing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "dependencies": {
    "http-message-signatures": "catalog:",
    "structured-headers": "catalog:"
  },
  "devDependencies": {
    "@effect/platform": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "kitchen-sink": "workspace:*",
    "shared-structures-core": "workspace:*",
    "typescript": "catalog:",
    "typescript-7": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform": "catalog:",
    "effect": "catalog:",
    "shared-structures-core": "workspace:*"
  }
}
