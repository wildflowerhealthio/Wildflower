{
  "name": "@wildflowerhealthio/health-viewer-medications",
  "version": "0.0.0",
  "private": true,
  "description": "The health viewer's medication source: FHIR R4 `MedicationRequest`s read through medication-core's dose regimens into health-viewer-fundamentals `LevelSeries` (one step line per medication, dose unit and dose basis), the `m:` series-id grammar, and the Medications catalogue group — exported as one `SeriesSource` value. No DOM, no React.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@wildflowerhealthio/fhir-r4": "workspace:*",
    "@wildflowerhealthio/health-viewer-fundamentals": "workspace:*",
    "@wildflowerhealthio/kitchen-sink": "workspace:*",
    "@wildflowerhealthio/medication-core": "workspace:*",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "typescript-7": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@wildflowerhealthio/health-viewer-fundamentals": "workspace:*",
    "@wildflowerhealthio/kitchen-sink": "workspace:*",
    "@wildflowerhealthio/medication-core": "workspace:*",
    "effect": "catalog:"
  }
}
