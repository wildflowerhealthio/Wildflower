# Copy to .env.local and fill in values. Committed values must remain empty.
#
# Sentry runtime config for this app. Vite inlines `VITE_*` keys into the
# bundle at build time. Nothing is reported until the visitor says yes in the
# consent dialog; `VITE_SENTRY_DSN_HEALTH_VIEWER` is read in `src/config.ts` and the rest by
# `configFromViteEnv` in `telemetry-web`.
#
# When `VITE_SENTRY_DSN_HEALTH_VIEWER` is empty, the app reports nothing whatever the visitor
# answers.

VITE_SENTRY_DSN_HEALTH_VIEWER=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
