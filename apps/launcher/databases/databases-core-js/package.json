{
  "name": "databases-core-js",
  "version": "0.0.0",
  "private": true,
  "description": "Data-management HTTP API + client. Host-agnostic Effect /databases endpoints (list + delete) for exporting and erasing the host's SQLite databases.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wildflowerhealthio/Wildflower.git",
    "directory": "apps/launcher/databases/databases-core-js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./clients": {
      "source": "./src/clients/index.ts",
      "default": "./dist/clients/index.js"
    },
    "./http-api-definition": {
      "source": "./src/http-api-definition/index.ts",
      "default": "./dist/http-api-definition/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@effect/platform": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "shared-structures-core": "workspace:*",
    "typescript": "catalog:",
    "typescript-7": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform": "catalog:",
    "effect": "catalog:"
  }
}
