{
  "name": "@wildflowerhealthio/collector-registry",
  "version": "0.0.0",
  "private": true,
  "description": "Assembly/registry layer for the collector slice — the most-downstream TS package: it statically imports each concrete `*-client-collector` and assembles their configs into a closed, compile-time discriminated union, alongside the CollectorBridge wire contract, CollectorBridgeMessageHandler dispatcher, and the HTTP API definition for the remotes endpoints. Shared model primitives (and the `./config-form` view contract) live in `collector-fundamentals`; concrete clients (e.g. `fhir-r4-client-collector`) depend on `collector-fundamentals` only — including for their config-form UI — never on the `collector-react` adapter.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wildflowerhealthio/Wildflower.git",
    "directory": "apps/launcher/collector/collector-registry"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./registry": {
      "source": "./src/registry.ts",
      "default": "./dist/registry.js"
    },
    "./clients": {
      "source": "./src/clients/index.ts",
      "default": "./dist/clients/index.js"
    },
    "./http-api-definition": {
      "source": "./src/http-api-definition/index.ts",
      "default": "./dist/http-api-definition/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@effect/platform": "catalog:",
    "@types/node": "catalog:",
    "@wildflowerhealthio/browser-sniffer-core": "workspace:*",
    "@wildflowerhealthio/collector-fundamentals": "workspace:*",
    "@wildflowerhealthio/effect-messaging-core": "workspace:*",
    "@wildflowerhealthio/fhir-r4-client-collector": "workspace:*",
    "@wildflowerhealthio/kitchen-sink": "workspace:*",
    "@wildflowerhealthio/rexall-be-well-collector": "workspace:*",
    "@wildflowerhealthio/shared-structures-core": "workspace:*",
    "@wildflowerhealthio/shoppers-drugmart-collector": "workspace:*",
    "@wildflowerhealthio/web-trace-collector": "workspace:*",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "typescript-7": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform": "catalog:",
    "@wildflowerhealthio/browser-sniffer-core": "workspace:*",
    "@wildflowerhealthio/collector-fundamentals": "workspace:*",
    "@wildflowerhealthio/effect-messaging-core": "workspace:*",
    "@wildflowerhealthio/fhir-r4-client-collector": "workspace:*",
    "@wildflowerhealthio/kitchen-sink": "workspace:*",
    "@wildflowerhealthio/rexall-be-well-collector": "workspace:*",
    "@wildflowerhealthio/shared-structures-core": "workspace:*",
    "@wildflowerhealthio/shoppers-drugmart-collector": "workspace:*",
    "@wildflowerhealthio/web-trace-collector": "workspace:*",
    "effect": "catalog:"
  }
}
