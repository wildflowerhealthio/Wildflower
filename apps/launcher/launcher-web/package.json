{
  "name": "@wildflowerhealthio/launcher-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app-root": {
      "source": "./src/app-root.tsx"
    },
    "./web-entry": {
      "source": "./src/web-entry.ts"
    },
    "./consented-entry-root": {
      "source": "./src/session/consented-entry-root.tsx"
    },
