{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wildflower Host",
  "version": "0.2.7",
  "identifier": "io.wildflowerhealth.hostapp",
  "build": {
    "beforeDevCommand": "vp run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "vp run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Wildflower Host",
        "width": 393,
        "height": 852
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../slices/apps/self-hosted-apps/": "self-hosted-apps/",
      "../../../slices/emr/emr-rust/assets/search-parameters-r4.json": "fhir-search-params/search-parameters-r4.json"
    }
  }
}
