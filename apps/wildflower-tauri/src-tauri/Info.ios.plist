<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iOS-only overlay; shared keys live in `Info.plist` beside it. Both keys
	     below are needed for the Files app to list the host's data directory
	     under "On My iPhone" — neither works alone, and what the second one
	     admits is a real trade-off. See the Data Directory Explanation. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
