<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Exposes the app container's `Documents` directory — where `resolve_data_dir`
	     in `src/lib.rs` puts the host's databases and saved files — to the Files
	     app, so a "Wildflower" folder appears under "On My iPhone". Merged over the
	     generated `gen/apple/wildflower-tauri_iOS/Info.plist` by `tauri ios build`.
	     See the Data Directory Explanation. -->
	<key>UIFileSharingEnabled</key>
	<true/>
</dict>
</plist>
