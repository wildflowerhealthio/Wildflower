<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iOS-only overlay; shared keys live in `Info.plist` beside it. Both keys
	     below are needed for the Files app to list the host's data directory
	     under "On My iPhone" — neither works alone, and what the second one
	     admits is a real trade-off. See the Data Directory Explanation. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- The background service keeps the Wildflower server running in the
	     `BGAppRefreshTask` and `BGProcessingTask` windows iOS grants. The
	     background-service plugin registers its tasks as the bundle identifier
	     plus `.bg-refresh` and `.bg-processing`; iOS runs only identifiers
	     listed here, and only with the matching background modes. See the
	     background-server-service Design Explanation. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).bg-refresh</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).bg-processing</string>
	</array>
</dict>
</plist>
