# Build-time tunnel connection defaults (optional).
#
# `build.rs` reads this file's sibling `.env` (gitignored) and re-emits these
# keys as compile-time env vars. `src/lib.rs` reads them via `option_env!` and
# seeds them into a fresh SQLite row on first run (see
# `tunnel_rust::SqliteTunnelStore::seed_if_absent`), so the tunnel connection survives
# a reinstall. Only fields left unconfigured in the DB are seeded — in-app edits
# are never overwritten. Values may also be supplied via the shell environment.
#
# Usage: copy this file to `.env` (same directory) and fill in the values.
# The relay block is seeded only when ALL FOUR relay fields are present.
#
# SECURITY: WILDFLOWER_TUNNEL_RELAY_TOKEN is a secret and is compiled into the
# distributed binary (an extractable artifact). This is an accepted trade-off for
# zero-touch reinstalls; leave it unset here and enter the token in-app if you'd
# rather keep the secret out of the binary.

# The public hostname the relay edge serves this device at.
WILDFLOWER_TUNNEL_PUBLIC_HOST=clinic.example.com

# Relay connection — all four are required together to seed the relay.
WILDFLOWER_TUNNEL_RELAY_REMOTE_ADDR=relay.example.com:2333
WILDFLOWER_TUNNEL_RELAY_TOKEN=replace-with-relay-token
WILDFLOWER_TUNNEL_RELAY_PUBLIC_KEY=replace-with-base64-noise-public-key
WILDFLOWER_TUNNEL_RELAY_SERVICE_NAME=wildflower
