# Copy to .env.local and fill in values. Committed values must remain empty.
#
# Sentry + OpenTelemetry runtime config. Vite inlines `VITE_*` keys into the
# bundle at build time.
#
# The base reports nothing until the user says yes in its consent dialog, and
# then to its own project: `VITE_SENTRY_DSN_WILDFLOWER_TAURI`, read in
# `src/main.tsx`. When it is empty, the base reports nothing whatever the user
# answers; the shared `VITE_SENTRY_DSN` is never read in its place.
#
# The rest are read by `configFromViteEnv` in `telemetry-web`.

VITE_SENTRY_DSN_WILDFLOWER_TAURI=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
VITE_SENTRY_PROFILES_SAMPLE_RATE=0.0
