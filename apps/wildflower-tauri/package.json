{
  "name": "wildflower-tauri",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "atool": "xcrun altool --upload-app --type ios --file \"src-tauri/gen/apple/build/arm64/Wildflower.ipa\" --apiKey 5BCV34AABD --apiIssuer 779a0265-ae31-49aa-937d-9a7e5b0d640f",
    "build": "tsc && vp build",
    "build:ios:prod": "tauri ios build --export-method app-store-connect && vp run atool",
    "dev": "vp dev",
    "dev:android": "tauri android dev -- --target aarch64-linux-android",
    "dev:ios": "tauri ios dev --host=\"$(ipconfig getifaddr en0)\"",
    "preview": "vp preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "catalog:",
    "@tauri-apps/plugin-fs": "catalog:",
    "@tauri-apps/plugin-opener": "catalog:",
    "effect": "catalog:",
    "effect-messaging-core": "workspace:*",
    "effect-messaging-tauri": "workspace:*",
    "gatekeeper-core": "workspace:*",
    "gatekeeper-react": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-tundraish": "workspace:*",
    "scopes-react": "workspace:*",
    "tundra-css": "catalog:",
    "wildflower-react": "workspace:*"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
