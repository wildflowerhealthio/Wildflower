{
  "name": "synthetic-data-dicom",
  "version": "0.0.0",
  "private": true,
  "description": "The DICOM synthetic data generator: a real, de-identified DICOM Part 10 image re-identified as a synthetic-data-fundamentals person on a story day (patient, dates and UIDs written with dicom's Part10, pixels untouched), and read back through dicom-importer-core onto the person's Patient from another source. Pure — no DOM, no fs, no React.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Assessment-is/wildflower.git",
    "directory": "apps/synthetic-data/synthetic-data-dicom"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./test-helpers": {
      "source": "./src/test-helpers.ts",
      "default": "./dist/test-helpers.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "dicom": "workspace:*",
    "dicom-importer-core": "workspace:*",
    "dicom-parser": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "fhir-r4": "workspace:*",
    "kitchen-sink": "workspace:*",
    "synthetic-data-fundamentals": "workspace:*",
    "typescript": "catalog:",
    "typescript-7": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "dicom": "workspace:*",
    "dicom-importer-core": "workspace:*",
    "effect": "catalog:",
    "fhir-r4": "workspace:*",
    "synthetic-data-fundamentals": "workspace:*"
  }
}
