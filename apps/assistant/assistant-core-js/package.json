{
  "name": "@wildflowerhealthio/assistant-core-js",
  "version": "0.0.0",
  "private": true,
  "description": "Assistant's core: the Claude API key and model choice kept in the browser, the two chat styles and their system prompts, the chat codec kept in sessionStorage, and one streamed turn of the chat through @anthropic-ai/sdk. No DOM, no React.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./test-helpers": {
      "source": "./src/test-helpers.ts",
      "default": "./dist/test-helpers.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@wildflowerhealthio/kitchen-sink": "workspace:*",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "typescript-7": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@wildflowerhealthio/kitchen-sink": "workspace:*",
    "effect": "catalog:"
  }
}
