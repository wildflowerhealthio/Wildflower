.env

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.pnpm-store
dist
dist-html
dist-ssr
*.local

# Generated by @tanstack/router-plugin (regenerated every build)
routeTree.gen.ts

# Environment files
.devcontainer/devcontainer.env

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.claude/scheduled_tasks.lock
.claude/worktrees/

# In-container parallel worktrees (.devcontainer/wf-worktree.sh)
.worktrees/

# CPU/heap profiles emitted by `vp run profile` (Node --cpu-prof output)
.profiles/
*.cpuprofile

# Rust target directory
target/

# Tauri plugin build artifacts. `.tauri/` is the tauri-cli's generated
# Tauri-API project (Swift Package on iOS, Gradle library on Android) that
# mobile builds resolve into; `.build/` and `Package.resolved` are SwiftPM
# outputs alongside it. `**` here catches both the iOS root-level
# (`plugins/<plugin>/.tauri/`) AND the Android nested location
# (`plugins/<plugin>/android/.tauri/`).
plugins/**/.tauri/
plugins/**/.build/
plugins/**/Package.resolved

# Per-checkout Cargo config generated by .devcontainer/postCreateCommand.sh
# and wf-worktree.sh — redirects target-dir off the macOS bind mount onto the
# wf-data Docker volume. Never committed; regenerated on container start.
.cargo/

# Effect schemas generated from the gatekeeper OpenAPI spec (trial;
# `openapi-to-effect`). Reference-only — the hand-written HttpApi in
# `http-api-definition/` stays the source of truth. Regenerate with:
#   vp run -C slices/gatekeeper/gatekeeper-core generate:openapi-schemas
# (gatekeeper-core's `prettier` + `prettier-plugin-jsdoc` devDeps exist only
# because openapi-to-effect requires them to format this output — they are NOT
# a project formatter; oxfmt/`vp check` still owns the repo.)
slices/gatekeeper/gatekeeper-core/src/http-api-definition/generated/
# /design-sync skill — staged converter scripts + their deps, regenerated
# build output, machine state (verdicts, generated previews, fan-out scratch).
# Durable inputs under .design-sync/ (config.json, NOTES.md, conventions.md,
# previews/, overrides/) ARE committed.
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Local scratch: unzipped design handoff + the dev-only scopes-react preview
# gallery (a Playwright screenshot harness). Not part of any package.
scratchpad_design/
