#!/usr/bin/env sh
# Pre-push tests. Installed by `vp config` (the `_/pre-push` delegator runs this
# file). Mirrors the test half of CI now that the workflows no longer run on
# pushes to main — CI remains a pre-merge (pull_request) gate, and this is the
# local backstop before anything leaves the machine.
#
# Coverage matches what CI runs on a PR (ci-typescript runs the same sequence):
#   - `vp run pack`          -> build internal projects' dist. Required before
#                               Jest: Jest doesn't honor the `source` export
#                               condition, so it resolves workspace deps from
#                               dist/ (Vitest reads source directly and wouldn't
#                               need this, but `test:changed` runs both).
#   - `vp run test:changed`  -> Vitest + Jest, scaling fast-check down for
#                               packages unchanged vs origin/main (mirrors the
#                               ci-typescript test step). The api-sync TS
#                               openapi-drift test runs inside `vp test`.
#   - scripts/checks/rust.sh pre-push -> cargo nextest (non-Tauri) + the Tauri
#                               crates' tests (mirrors ci-rust.yml / ci-rust-tauri.yml).
#                               The api-sync Rust snapshot test is an ordinary
#                               #[test], so it runs here too. Self-skips when the
#                               Rust toolchain (or the Tauri GTK libs) is absent.
set -e

vp run pack
vp run test:changed
./scripts/checks/rust.sh pre-push
